+/// Номера слотов отсечения: разбираются один раз и запоминаются вместе с таблицей методов класса
+/// `Object3D` — если движок окажется загружен вторым экземпляром, номера у него будут свои.
+fn culling_slots<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    class_object: ClassObject<'gc>,
+    object: Object<'gc>,
+    camera: Object<'gc>,
+) -> Option<CullingSlots> {
+    let key = class_object.vtable().id();
+    if let Some((known, slots)) = SLOTS.with(|cache| *cache.borrow())
+        && known == key
+    {
+        return Some(slots);
+    }
+    if SLOTS_HOPELESS.with(|flag| flag.get()) {
+        return None;
+    }
+
+    match resolve_slots(activation, class_object, object, camera) {
+        Ok(slots) => {
+            SLOTS.with(|cache| *cache.borrow_mut() = Some((key, slots)));
+            Some(slots)
+        }
+        Err(hopeless) => {
+            if hopeless {
+                SLOTS_HOPELESS.with(|flag| flag.set(true));
+            }
+            None
+        }
+    }
+}
