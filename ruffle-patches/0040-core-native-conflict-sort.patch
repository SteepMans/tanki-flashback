+/// Номера слотов для сортировки списка прозрачной геометрии по габаритам.
+#[derive(Clone, Copy)]
+struct VgSortSlots {
+    next: usize,
+    bound_min: usize,
+    bound_max: usize,
+    axis_min: [usize; 3],
+    axis_max: [usize; 3],
+    vg_vtable: u32,
+}
+
+thread_local! {
+    static VG_SORT_SLOTS: RefCell<Option<(u32, VgSortSlots)>> = const { RefCell::new(None) };
+    static VG_SORT_HOPELESS: Cell<bool> = const { Cell::new(false) };
+}
+
+fn vg_sort_slots<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    class_object: ClassObject<'gc>,
+    list: Object<'gc>,
+) -> Option<VgSortSlots> {
+    let key = class_object.vtable().id();
+    if let Some((known, slots)) = VG_SORT_SLOTS.with(|cache| *cache.borrow())
+        && known == key
+    {
+        return Some(slots);
+    }
+    if VG_SORT_HOPELESS.with(|flag| flag.get()) {
+        return None;
+    }
+
+    let engine = |activation: &mut Activation<'_, 'gc>, name| slot_of(activation, list, name, true);
+    let resolved = (|| {
+        Some(VgSortSlots {
+            next: engine(activation, "next")?,
+            bound_min: engine(activation, "boundMin")?,
+            bound_max: engine(activation, "boundMax")?,
+            axis_min: [
+                engine(activation, "boundMinX")?,
+                engine(activation, "boundMinY")?,
+                engine(activation, "boundMinZ")?,
+            ],
+            axis_max: [
+                engine(activation, "boundMaxX")?,
+                engine(activation, "boundMaxY")?,
+                engine(activation, "boundMaxZ")?,
+            ],
+            vg_vtable: list.vtable().id(),
+        })
+    })();
+
+    match resolved {
+        Some(slots) => {
+            VG_SORT_SLOTS.with(|cache| *cache.borrow_mut() = Some((key, slots)));
+            Some(slots)
+        }
+        None => {
+            // Разбор опирается только на имена полей, поэтому неудача окончательна.
+            VG_SORT_HOPELESS.with(|flag| flag.set(true));
+            None
+        }
+    }
+}
+
+/// Ось, по которой сортируют: движок передаёт её двумя флагами.
+#[inline(always)]
+fn vg_axis(by_x: bool, by_y: bool) -> usize {
+    if by_x {
+        0
+    } else if by_y {
+        1
+    } else {
+        2
+    }
+}
+
+/// Лист рекурсии: у одиночного звена ключ сортировки берётся прямо из габаритов по выбранной оси.
+#[inline(always)]
+fn vg_set_key<'gc>(node: Object<'gc>, axis: usize, slots: &VgSortSlots, mc: &Mutation<'gc>) {
+    // Приведение к Number делает и байткод: `setproperty` в поле типа Number.
+    for (from, to) in [
+        (slots.axis_min[axis], slots.bound_min),
+        (slots.axis_max[axis], slots.bound_max),
+    ] {
+        let value = node.get_slot(from).try_as_f64().unwrap_or(f64::NAN);
+        node.set_slot_no_coerce(to, Value::Number(value), mc);
+    }
+}
+
+#[inline(always)]
+fn vg_key<'gc>(node: Object<'gc>, slots: &VgSortSlots) -> f64 {
+    // Поле объявлено как Number; ни разу не записанное движок тоже видит как NaN, а с NaN
+    // сравнение `lessthan` в байткоде ложно — как и `<` здесь.
+    node.get_slot(slots.bound_min).try_as_f64().unwrap_or(f64::NAN)
+}
+
+/// `ConflictContainer.f5e49019` — сортировка слиянием списка прозрачной геометрии по ближней
+/// границе габаритного ящика вдоль выбранной оси. Ступень AABB, через которую движок прогоняет
+/// прозрачные объекты каждый кадр: на стенде это самый крупный метод кадра.
+///
+/// Перевод из байткода буквальный, включая приём со ссылками: `next` переписывается только в тот
+/// момент, когда слияние переключается с одного списка на другой, — пока идём по одному, ссылки
+/// уже верны.
+fn vg_sort_list<'gc>(
+    list: Object<'gc>,
+    axis: usize,
+    slots: &VgSortSlots,
+    mc: &Mutation<'gc>,
+) -> Object<'gc> {
+    // Середина списка: `slow` идёт на шаг, `fast` — на два.
+    let mut slow = list;
+    let mut fast = list.get_slot(slots.next).as_object();
+    while let Some(node) = fast {
+        if node.get_slot(slots.next).as_object().is_none() {
+            break;
+        }
+        slow = match slow.get_slot(slots.next).as_object() {
+            Some(next) => next,
+            None => break,
+        };
+        fast = node
+            .get_slot(slots.next)
+            .as_object()
+            .and_then(|next| next.get_slot(slots.next).as_object());
+    }
+
+    let mut left = list;
+    let right = slow.get_slot(slots.next);
+    slow.set_slot_no_coerce(slots.next, Value::Null, mc);
+
+    if left.get_slot(slots.next).as_object().is_some() {
+        left = vg_sort_list(left, axis, slots, mc);
+    } else {
+        vg_set_key(left, axis, slots, mc);
+    }
+
+    let right = match right.as_object() {
+        Some(right) => {
+            if right.get_slot(slots.next).as_object().is_some() {
+                vg_sort_list(right, axis, slots, mc)
+            } else {
+                vg_set_key(right, axis, slots, mc);
+                right
+            }
+        }
+        // Список из одного звена: правой половины нет, сливать не с чем.
+        None => return left,
+    };
+
+    // Голова результата и с какой из половин мы сейчас идём.
+    let mut from_left = vg_key(left, slots) < vg_key(right, slots);
+    let head;
+    let mut left_node = Some(left);
+    let mut right_node = Some(right);
+    if from_left {
+        head = left;
+        left_node = left.get_slot(slots.next).as_object();
+    } else {
+        head = right;
+        right_node = right.get_slot(slots.next).as_object();
+    }
+    let mut tail = head;
+
+    loop {
+        let (Some(a), Some(b)) = (left_node, right_node) else {
+            // Один из списков кончился — дописываем хвост второго целиком.
+            let rest = left_node.or(right_node);
+            if let Some(rest) = rest {
+                tail.set_slot_no_coerce(slots.next, Value::Object(rest), mc);
+            } else {
+                tail.set_slot_no_coerce(slots.next, Value::Null, mc);
+            }
+            return head;
+        };
+
+        if from_left {
+            if vg_key(a, slots) < vg_key(b, slots) {
+                // Идём по той же половине: ссылка уже стоит верно.
+                tail = a;
+                left_node = a.get_slot(slots.next).as_object();
+            } else {
+                tail.set_slot_no_coerce(slots.next, Value::Object(b), mc);
+                tail = b;
+                right_node = b.get_slot(slots.next).as_object();
+                from_left = false;
+            }
+        } else if vg_key(b, slots) < vg_key(a, slots) {
+            tail = b;
+            right_node = b.get_slot(slots.next).as_object();
+        } else {
+            tail.set_slot_no_coerce(slots.next, Value::Object(a), mc);
+            tail = a;
+            left_node = a.get_slot(slots.next).as_object();
+            from_left = true;
+        }
+    }
+}
+
+/// Точка входа сортировки: разбирает аргументы и отсеивает случай, на котором байткод бросает
+/// ошибку (список из одного звена — у него нет правой половины), до любых записей.
+fn conflict_sort<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    method: Method<'gc>,
+) -> Option<Value<'gc>> {
+    let list = activation.local_register(1).as_object()?;
+    let by_x = match activation.local_register(2) {
+        Value::Bool(value) => value,
+        _ => return None,
+    };
+    let by_y = match activation.local_register(3) {
+        Value::Bool(value) => value,
+        _ => return None,
+    };
+
+    let slots = vg_sort_slots(activation, declaring_class(method)?, list)?;
+    if list.vtable().id() != slots.vg_vtable {
+        return None;
+    }
+    // На списке из одного звена байткод падает на обращении к правой половине; пусть падает он.
+    if list.get_slot(slots.next).as_object().is_none() {
+        return None;
+    }
+
+    let mc = activation.gc();
+    let sorted = vg_sort_list(list, vg_axis(by_x, by_y), &slots, mc);
+    Some(Value::Object(sorted))
+}
+
 /// Собирает в снимок всё, что обход структуры граней перезапишет: у каждой вершины три
 /// координаты и номер преобразования. Порядок обхода тот же, что у самого счёта, поэтому два
 /// снимка сравнимы поэлементно.
@@ -1690,6 +1921,10 @@ pub struct Snapshot<'gc> {
     /// Куда смотреть и что там было. Полей может быть с разных объектов: столкновение эллипсоида
     /// пишет в два вектора сразу, а загрузка констант — в элементы вектора, а не в слоты.
     fields: Vec<(Place<'gc>, f64)>,
+    /// Поля-ссылки: их надо возвращать самим объектом, числом это не выразить. Нужны сортировке
+    /// списка — она переставляет `next` у всех звеньев, и без отката байткод считал бы уже не с
+    /// того входа.
+    links: Vec<(Object<'gc>, usize, Value<'gc>)>,
 }
 
 /// Место, куда пишет заменяемый метод: поле объекта или элемент вектора.
@@ -1698,18 +1933,25 @@ enum Place<'gc> {
     Slot(Object<'gc>, usize),
     /// Целочисленное поле: восстанавливать его дробным нельзя, слот объявлен как `int`.
     IntSlot(Object<'gc>, usize),
+    /// Только для сравнения: адрес объекта в поле-ссылке. Откатывать такое числом нельзя, откат
+    /// таких полей делается отдельным списком `links`.
+    LinkAddress,
     Element(Object<'gc>, usize),
 }
 
 impl<'gc> Snapshot<'gc> {
     /// Вернуть поля в состояние до нативного счёта.
     pub fn restore(&self, mc: &Mutation<'gc>) {
+        for (object, slot, value) in self.links.iter() {
+            object.set_slot_no_coerce(*slot, *value, mc);
+        }
         for (place, value) in self.fields.iter() {
             match place {
                 Place::Slot(object, slot) => set(*object, *slot, *value, mc),
                 Place::IntSlot(object, slot) => {
                     object.set_slot_no_coerce(*slot, Value::Integer(*value as i32), mc);
                 }
+                Place::LinkAddress => {}
                 Place::Element(object, at) => {
                     if let Some(mut storage) = object.as_vector_storage_mut(mc) {
                         storage.set_in_range(*at, Value::Number(*value));
@@ -1734,10 +1976,14 @@ impl<'gc> Snapshot<'gc> {
 
 /// Совпадают ли два ответа метода. Сравнение побитовое: методы столкновений возвращают дробное
