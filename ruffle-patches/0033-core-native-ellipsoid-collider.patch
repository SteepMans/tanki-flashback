+/// Номер слота по одному лишь имени, без пространства имён. Поля коллайдера объявлены в приватном
+/// пространстве своего класса, а такое пространство снаружи не построить: у него внутренний
+/// номер, уникальный на единицу трансляции. Имена там обфусцированы и в классе единственны, так
+/// что совпадения по имени достаточно. Перебор идёт один раз, при разборе слотов.
+fn slot_by_local_name<'gc>(object: Object<'gc>, name: &str) -> Option<usize> {
+    object
+        .vtable()
+        .resolved_traits()
+        .iter()
+        .find_map(|(local, _, property)| match property {
+            Property::Slot { slot_id } | Property::ConstSlot { slot_id }
+                if &*local.to_utf8_lossy() == name =>
+            {
+                Some(*slot_id)
+            }
+            _ => None,
+        })
+}
+
+/// Обфусцированные имена полей `EllipsoidCollider`. Как и у коробок, они постоянны от сборки к
+/// сборке; если сборка клиента поменяется, поле не найдётся и метод посчитает интерпретатор.
+mod ellipsoid_fields {
+    /// Треугольники карты, отобранные для проверки, и их число.
+    pub const FACES: &str = "faces";
+    pub const FACE_COUNT: &str = "e6b9feef";
+    /// Радиус эллипсоида в его собственном масштабе.
+    pub const RADIUS: &str = "radius";
+    /// Положение центра, вектор перемещения за шаг и положение на прошлом шаге.
+    pub const POSITION: &str = "c6464302";
+    pub const DISPLACEMENT: &str = "d3246eba";
+    pub const PREVIOUS: &str = "c6a71617";
+    /// Куда метод кладёт найденную точку касания и плоскость касания (в `w` — её смещение).
+    pub const CONTACT_POINT: &str = "cad4534";
+    pub const CONTACT_PLANE: &str = "a440cac7";
+}
+
+/// Номера слотов, нужных для столкновения эллипсоида с треугольниками.
+#[derive(Clone, Copy)]
+struct EllipsoidSlots {
+    faces: usize,
+    face_count: usize,
+    radius: usize,
+    position: usize,
+    displacement: usize,
+    previous: usize,
+    contact_point: usize,
+    contact_plane: usize,
+    /// `wrapper` у треугольника, `vertex` и `next` у звена списка.
+    face_wrapper: usize,
+    wrapper_vertex: usize,
+    wrapper_next: usize,
+    /// cameraX, cameraY, cameraZ вершины.
+    vertex_camera: [usize; 3],
+    /// x, y, z, w вектора.
+    vector: [usize; 4],
+    /// Таблицы методов, на которых слоты разобраны: объект другого класса имеет свои номера.
+    face_vtable: u32,
+    wrapper_vtable: u32,
+    vertex_vtable: u32,
+    vector_vtable: u32,
+}
+
+thread_local! {
+    /// Как и у остальных замен, запоминается только удача.
+    static ELLIPSOID_SLOTS: RefCell<Option<(u32, EllipsoidSlots)>> = const { RefCell::new(None) };
+    /// Не найденное имя поля не появится, повторять разбор незачем.
+    static ELLIPSOID_HOPELESS: Cell<bool> = const { Cell::new(false) };
+}
+
+fn ellipsoid_slots<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    this: Object<'gc>,
+) -> Option<EllipsoidSlots> {
+    let key = this.vtable().id();
+    if let Some((known, slots)) = ELLIPSOID_SLOTS.with(|cache| *cache.borrow())
+        && known == key
+    {
+        return Some(slots);
+    }
+    if ELLIPSOID_HOPELESS.with(|flag| flag.get()) {
+        return None;
+    }
+
+    match resolve_ellipsoid_slots(activation, this) {
+        Ok(slots) => {
+            ELLIPSOID_SLOTS.with(|cache| *cache.borrow_mut() = Some((key, slots)));
+            Some(slots)
+        }
+        Err((reason, hopeless)) => {
+            tracing::debug!("native ellipsoid: слоты не разобраны: {reason} (навсегда={hopeless})");
+            if hopeless {
+                ELLIPSOID_HOPELESS.with(|flag| flag.set(true));
+            }
+            None
+        }
+    }
+}
+
+/// Во второй половине ответа — окончательна ли неудача: не найденное имя поля не появится, а
+/// незаполненное поле объекта (коллайдер ещё не получил ни одного треугольника) появится позже.
+fn resolve_ellipsoid_slots<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    this: Object<'gc>,
+) -> Result<EllipsoidSlots, (&'static str, bool)> {
+    use ellipsoid_fields::*;
+
+    let named = |name, reason| slot_by_local_name(this, name).ok_or((reason, true));
+
+    let faces = named(FACES, "нет поля треугольников")?;
+    let position = named(POSITION, "нет поля положения")?;
+    let contact_point = named(CONTACT_POINT, "нет поля точки касания")?;
+
+    // Классы треугольника, звена и вершины видны только по живым объектам: имена их полей нам
+    // известны, а вот на каком классе их искать — нет.
+    let face = this
+        .get_slot(faces)
+        .as_object()
+        .ok_or(("список треугольников не заполнен", false))?
+        .as_vector_storage()
+        .ok_or(("список треугольников не вектор", true))?
+        .get_optional(0)
+        .ok_or(("список треугольников пуст", false))?
+        .as_object()
+        .ok_or(("первый треугольник пуст", false))?;
+    let wrapper = face
+        .get_slot(slot_of(activation, face, "wrapper", true).ok_or(("нет поля звена", true))?)
+        .as_object()
+        .ok_or(("звено не заполнено", false))?;
+    let vertex = wrapper
+        .get_slot(slot_of(activation, wrapper, "vertex", true).ok_or(("нет поля вершины", true))?)
+        .as_object()
+        .ok_or(("вершина не заполнена", false))?;
+    let vector = this
+        .get_slot(contact_point)
+        .as_object()
+        .ok_or(("точка касания не заполнена", false))?;
+
+    let engine = |activation: &mut Activation<'_, 'gc>, object, name| {
+        slot_of(activation, object, name, true).ok_or(("нет поля движка", true))
+    };
+    let public = |activation: &mut Activation<'_, 'gc>, object, name| {
+        slot_of(activation, object, name, false).ok_or(("нет поля вектора", true))
+    };
+
+    Ok(EllipsoidSlots {
+        faces,
+        face_count: named(FACE_COUNT, "нет поля числа треугольников")?,
+        radius: named(RADIUS, "нет поля радиуса")?,
+        position,
+        displacement: named(DISPLACEMENT, "нет поля смещения")?,
+        previous: named(PREVIOUS, "нет поля прошлого положения")?,
+        contact_point,
+        contact_plane: named(CONTACT_PLANE, "нет поля плоскости касания")?,
+        face_wrapper: engine(activation, face, "wrapper")?,
+        wrapper_vertex: engine(activation, wrapper, "vertex")?,
+        wrapper_next: engine(activation, wrapper, "next")?,
+        vertex_camera: [
+            engine(activation, vertex, "cameraX")?,
+            engine(activation, vertex, "cameraY")?,
+            engine(activation, vertex, "cameraZ")?,
+        ],
+        vector: [
+            public(activation, vector, "x")?,
+            public(activation, vector, "y")?,
+            public(activation, vector, "z")?,
+            public(activation, vector, "w")?,
+        ],
+        face_vtable: face.vtable().id(),
+        wrapper_vtable: wrapper.vtable().id(),
+        vertex_vtable: vertex.vtable().id(),
+        vector_vtable: vector.vtable().id(),
+    })
+}
+
+/// Три координаты вектора движка (`flash.geom.Vector3D`).
+#[inline(always)]
+fn vector3<'gc>(vector: Object<'gc>, slots: &EllipsoidSlots) -> Option<(f64, f64, f64)> {
+    if vector.vtable().id() != slots.vector_vtable {
+        return None;
+    }
+    Some((
+        vector.get_slot(slots.vector[0]).try_as_f64()?,
+        vector.get_slot(slots.vector[1]).try_as_f64()?,
+        vector.get_slot(slots.vector[2]).try_as_f64()?,
+    ))
+}
+
+/// Три координаты вершины треугольника в системе координат камеры.
+#[inline(always)]
+fn vertex3<'gc>(vertex: Object<'gc>, slots: &EllipsoidSlots) -> Option<(f64, f64, f64)> {
+    if vertex.vtable().id() != slots.vertex_vtable {
+        return None;
+    }
+    Some((
+        vertex.get_slot(slots.vertex_camera[0]).try_as_f64()?,
+        vertex.get_slot(slots.vertex_camera[1]).try_as_f64()?,
+        vertex.get_slot(slots.vertex_camera[2]).try_as_f64()?,
+    ))
+}
+
+/// `EllipsoidCollider.ecfa5c3()` — заметание эллипсоида игрока по треугольникам карты: самый
+/// крупный кусок кадра в бою (порядка 384 тысяч инструкций за вызов, раз в кадр). Для каждого
+/// треугольника считается плоскость, точка касания уточняется по рёбрам и вершинам, и из всех
+/// касаний остаётся самое раннее по времени шага.
+///
+/// Тело переведено из байткода один в один: имена переменных повторяют номера локальных ячеек
+/// (`l2` — это `local2`), скобки и порядок действий оставлены как есть. В плавающей точке порядок
+/// влияет на последний бит, а по этому биту физика решает, упёрся танк в стену или проехал.
+///
+/// Оба вектора-результата (`cad4534`, `a440cac7`) заполняются одной записью в самом конце, а не по
+/// ходу перебора, как в байткоде. Это единственное намеренное отличие, и оно не видно снаружи:
+/// внутри метода эти поля читаются только сразу после собственной записи, а наружу видно лишь
+/// последнее — зато при отказе на середине объект остаётся нетронутым и байткод считает с чистого
+/// листа.
+#[allow(clippy::too_many_lines)]
+fn ellipsoid_collide<'gc>(activation: &mut Activation<'_, 'gc>) -> Option<Value<'gc>> {
+    let this = activation.local_register(0).as_object()?;
+    let slots = ellipsoid_slots(activation, this)?;
+
+    let radius = this.get_slot(slots.radius).try_as_f64()?;
+    let face_count = match this.get_slot(slots.face_count) {
+        Value::Integer(value) => value,
+        _ => return None,
+    };
+    let faces = this.get_slot(slots.faces).as_object()?;
+    let (cx, cy, cz) = vector3(this.get_slot(slots.position).as_object()?, &slots)?;
+    let displacement = this.get_slot(slots.displacement).as_object()?;
+    let (dx, dy, dz) = vector3(displacement, &slots)?;
+    let (px, py, pz) = vector3(this.get_slot(slots.previous).as_object()?, &slots)?;
+
+    // `Vector3D.length` — геттер, а не поле: повторяем его счёт.
+    let l32 = (dx * dx + dy * dy + dz * dz).sqrt();
+    let mut l7 = 1.0f64;
+    // Лучшее найденное касание: точка и плоскость. Пока его нет, векторы не трогаем.
+    let mut hit: Option<([f64; 3], [f64; 4])> = None;
+    // Точка касания живёт МЕЖДУ треугольниками, а не заводится заново на каждом: если у очередного
+    // треугольника ни одно ребро не оказалось ближе (например, длина ребра дала NaN), байткод
+    // возьмёт сюда значение от предыдущего треугольника, а на первом — NaN.
+    let (mut l38, mut l10, mut l25) = (f64::NAN, f64::NAN, f64::NAN);
+
+    let faces = faces.as_vector_storage()?;
+    for l29 in 0..face_count {
+        let face = faces.get_optional(l29 as usize)?.as_object()?;
+        if face.vtable().id() != slots.face_vtable {
+            return None;
+        }
+        let mut l37 = face.get_slot(slots.face_wrapper).as_object()?;
+        if l37.vtable().id() != slots.wrapper_vtable {
+            return None;
+        }
+        let l20 = l37.get_slot(slots.wrapper_vertex).as_object()?;
+        l37 = l37.get_slot(slots.wrapper_next).as_object()?;
+        if l37.vtable().id() != slots.wrapper_vtable {
+            return None;
+        }
+        let l21 = l37.get_slot(slots.wrapper_vertex).as_object()?;
+        l37 = l37.get_slot(slots.wrapper_next).as_object()?;
+        if l37.vtable().id() != slots.wrapper_vtable {
+            return None;
+        }
+        let l23 = l37.get_slot(slots.wrapper_vertex).as_object()?;
+
+        let (v0x, v0y, v0z) = vertex3(l20, &slots)?;
+        let (v1x, v1y, v1z) = vertex3(l21, &slots)?;
+        let (v2x, v2y, v2z) = vertex3(l23, &slots)?;
+
+        let l34 = v1x - v0x;
+        let l43 = v1y - v0y;
+        let l11 = v1z - v0z;
+        let l40 = v2x - v0x;
+        let l22 = v2y - v0y;
+        let l1 = v2z - v0z;
+
+        let mut l2 = l1 * l43 - l22 * l11;
+        let mut l3 = l40 * l11 - l1 * l34;
+        let mut l4 = l22 * l34 - l40 * l43;
+
+        let mut l45 = l2 * l2 + l3 * l3 + l4 * l4;
+        // Вырожденный треугольник пропускается: нормаль у него не считается.
+        if !(l45 > 0.001) {
+            continue;
+        }
+        l45 = 1.0 / l45.sqrt();
+        l2 *= l45;
+        l3 *= l45;
+        l4 *= l45;
+
+        let l24 = v0x * l2 + v0y * l3 + v0z * l4;
+        let l5 = (cx * l2 + cy * l3 + cz * l4) - l24;
+
+        // Куда упирается эллипсоид в плоскость треугольника: если центр уже ближе радиуса, берём
+        // проекцию центра, иначе — точку, где сфера коснётся плоскости по ходу шага.
+        let (l16, l30, l36) = if l5 < radius {
+            (cx - l2 * l5, cy - l3 * l5, cz - l4 * l5)
+        } else {
+            let l35 = (l5 - radius) / (l5 - px * l2 - py * l3 - pz * l4 + l24);
+            (
+                (cx + dx * l35) - l2 * radius,
+                (cy + dy * l35) - l3 * radius,
+                (cz + dz * l35) - l4 * radius,
+            )
+        };
+
+        // Лежит ли точка внутри треугольника; если нет — ищем ближайшую точку на рёбрах.
+        let mut l14 = 1e22f64;
+        let mut l27 = true;
+        let mut l6 = Some(face.get_slot(slots.face_wrapper).as_object()?);
+        while let Some(wrapper) = l6 {
+            if wrapper.vtable().id() != slots.wrapper_vtable {
+                return None;
+            }
+            let l20 = wrapper.get_slot(slots.wrapper_vertex).as_object()?;
+            let next = wrapper.get_slot(slots.wrapper_next);
+            let l21 = match next.as_object() {
+                Some(next) => {
+                    if next.vtable().id() != slots.wrapper_vtable {
+                        return None;
+                    }
+                    next.get_slot(slots.wrapper_vertex).as_object()?
+                }
+                None => face
+                    .get_slot(slots.face_wrapper)
+                    .as_object()?
+                    .get_slot(slots.wrapper_vertex)
+                    .as_object()?,
+            };
+
+            let (e0x, e0y, e0z) = vertex3(l20, &slots)?;
+            let (e1x, e1y, e1z) = vertex3(l21, &slots)?;
+
+            let mut l34 = e1x - e0x;
+            let mut l43 = e1y - e0y;
+            let mut l11 = e1z - e0z;
+            let mut l40 = l16 - e0x;
+            let mut l22 = l30 - e0y;
+            let mut l1 = l36 - e0z;
+
+            let l26 = l1 * l43 - l22 * l11;
+            let l8 = l40 * l11 - l1 * l34;
+            let l39 = l22 * l34 - l40 * l43;
+
+            if l26 * l2 + l8 * l3 + l39 * l4 < 0.0 {
+                let mut l12 = l34 * l34 + l43 * l43 + l11 * l11;
+                let l46 = (l26 * l26 + l8 * l8 + l39 * l39) / l12;
+                if l46 < l14 {
+                    l12 = l12.sqrt();
+                    l34 /= l12;
+                    l43 /= l12;
+                    l11 /= l12;
+                    let l35 = l34 * l40 + l43 * l22 + l11 * l1;
+                    if l35 < 0.0 {
+                        // Ближе всего начало ребра.
+                        let l19 = l40 * l40 + l22 * l22 + l1 * l1;
+                        if l19 < l14 {
+                            l14 = l19;
+                            l38 = e0x;
+                            l10 = e0y;
+                            l25 = e0z;
+                        }
+                    } else if l35 > l12 {
+                        // Ближе всего конец ребра.
+                        l40 = l16 - e1x;
+                        l22 = l30 - e1y;
+                        l1 = l36 - e1z;
+                        let l19 = l40 * l40 + l22 * l22 + l1 * l1;
+                        if l19 < l14 {
+                            l14 = l19;
+                            l38 = e1x;
+                            l10 = e1y;
+                            l25 = e1z;
+                        }
+                    } else {
+                        // Ближе всего точка на самом ребре.
+                        l14 = l46;
+                        l38 = e0x + l34 * l35;
+                        l10 = e0y + l43 * l35;
+                        l25 = e0z + l11 * l35;
