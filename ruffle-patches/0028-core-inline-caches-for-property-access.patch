diff --git a/core/src/avm2/inline_cache.rs b/core/src/avm2/inline_cache.rs
new file mode 100644
index 00000000..e42ad66f
--- /dev/null
+++ b/core/src/avm2/inline_cache.rs
@@ -0,0 +1,118 @@
+//! Инлайн-кэши мест обращения к свойствам.
+//!
+//! `callproperty`/`getproperty`/`setproperty` ищут имя в таблице методов класса: считается хэш
+//! имени свойства (по всем его символам, кэша хэша у строк движка нет), потом идёт поиск в
+//! хэш-таблице и перебор пространств имён. И так на КАЖДОМ выполнении инструкции, хотя в горячем
+//! коде по одному и тому же месту почти всегда приходит объект того же класса.
+//!
+//! Оптимизатор типов уже заменяет такие обращения на прямой номер слота или метода там, где тип
+//! известен статически (`optimizer::type_aware`). Остаётся то, что он в принципе не может решить:
+//! вызовы через интерфейс (у каждого наследника свой номер метода), поля значений типа `*` и
+//! `Object`. Физика клиента написана именно так, поэтому в бою этих инструкций много.
+//!
+//! Здесь на каждое такое место кода заводится одна ячейка «последняя таблица методов -> что в ней
+//! нашлось». Проверка на входе — сравнение номера таблицы (см. `VTable::id`), и при совпадении
+//! поиск имени не делается вовсе. Таблица методов после создания не меняется, так что запомненный
+//! ответ не может протухнуть, а смена класса объекта видна по номеру. Отрицательный ответ («такого
+//! свойства в классе нет, ищи среди динамических») кэшируется тоже — он стоит того же поиска.
+//!
+//! Ячейки живут в `VerifiedMethodInfo::caches`, номер ячейки прошит в саму инструкцию. Отдельным
+//! массивом, а не полем инструкции, потому что инструкция обязана оставаться в 16 байтах.
+
+use crate::avm2::property::Property;
+use crate::avm2::vtable::VTable;
+use std::cell::Cell;
+
+/// Что запомнено в ячейке. Разложенный `Option<Property>`: хранить его целиком было бы 32 байта
+/// на место кода, а мест этих десятки тысяч.
+mod kind {
+    pub const NONE: u8 = 0;
+    pub const SLOT: u8 = 1;
+    pub const CONST_SLOT: u8 = 2;
+    pub const METHOD: u8 = 3;
+    pub const VIRTUAL: u8 = 4;
+}
+
+/// Признак «нет такого номера» для половинок `Virtual`.
+const NO_ID: u32 = u32::MAX;
+
+/// Номер ячейки у инструкции, которой кэш не положен. Заведомо за границей массива ячеек:
+/// столько мест обращения в одном методе не бывает, а если бы и было — лишние остались бы без
+/// кэша, и только.
+pub const NO_CACHE: u16 = u16::MAX;
+
+/// Одно место обращения к свойству. 16 байт: номер таблицы, вид найденного свойства и до двух
+/// номеров (слот/метод, для свойств с методами доступа — читающий и пишущий).
+#[derive(Default)]
+pub struct PropertyCache {
+    /// Номер таблицы методов, для которой запомнен ответ; 0 — ячейка пуста.
+    vtable_id: Cell<u32>,
+    kind: Cell<u8>,
+    first: Cell<u32>,
+    second: Cell<u32>,
+}
+
+impl PropertyCache {
+    /// Свойство по имени в этой таблице методов. При попадании поиск имени не выполняется.
+    #[inline(always)]
+    pub fn resolve<'gc>(
+        &self,
+        vtable: VTable<'gc>,
+        multiname: &crate::avm2::Multiname<'gc>,
+    ) -> Option<Property> {
+        let id = vtable.id();
+        if self.vtable_id.get() == id {
+            return self.stored();
+        }
+
+        let property = vtable.get_trait(multiname);
+        self.store(id, property);
+        property
+    }
+
+    #[inline(always)]
+    fn stored(&self) -> Option<Property> {
+        match self.kind.get() {
+            kind::SLOT => Some(Property::Slot {
+                slot_id: self.first.get() as usize,
+            }),
+            kind::CONST_SLOT => Some(Property::ConstSlot {
+                slot_id: self.first.get() as usize,
+            }),
+            kind::METHOD => Some(Property::Method {
+                disp_id: self.first.get() as usize,
+            }),
+            kind::VIRTUAL => Some(Property::Virtual {
+                get: (self.first.get() != NO_ID).then(|| self.first.get() as usize),
+                set: (self.second.get() != NO_ID).then(|| self.second.get() as usize),
+            }),
+            _ => None,
+        }
+    }
+
+    fn store(&self, vtable_id: u32, property: Option<Property>) {
+        // Номера слотов и методов в живом коде и до тысячи не доходят, но если чужой SWF всё же
+        // выйдет за границу, место кода просто останется без кэша и будет считаться как раньше.
+        let short = |id: usize| u32::try_from(id).ok().filter(|id| *id != NO_ID);
+        let Some((kind, first, second)) = (match property {
+            None => Some((kind::NONE, 0, 0)),
+            Some(Property::Slot { slot_id }) => short(slot_id).map(|id| (kind::SLOT, id, 0)),
+            Some(Property::ConstSlot { slot_id }) => {
+                short(slot_id).map(|id| (kind::CONST_SLOT, id, 0))
+            }
+            Some(Property::Method { disp_id }) => short(disp_id).map(|id| (kind::METHOD, id, 0)),
+            Some(Property::Virtual { get, set }) => {
+                let get = get.map_or(Some(NO_ID), short);
+                let set = set.map_or(Some(NO_ID), short);
+                get.zip(set).map(|(get, set)| (kind::VIRTUAL, get, set))
+            }
+        }) else {
+            return;
+        };
+
+        self.kind.set(kind);
+        self.first.set(first);
+        self.second.set(second);
+        self.vtable_id.set(vtable_id);
+    }
+}
