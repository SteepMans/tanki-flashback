@@ -66,6 +69,14 @@ pub fn fusion_enabled() -> bool {
     FUSION_ENABLED.load(Ordering::Relaxed)
 }
 
+pub fn set_inline_caches_enabled(value: bool) {
+    INLINE_CACHES_ENABLED.store(value, Ordering::Relaxed);
+}
+
+pub fn inline_caches_enabled() -> bool {
+    INLINE_CACHES_ENABLED.load(Ordering::Relaxed)
+}
+
 pub fn set_native_paths_enabled(value: bool) {
     NATIVE_PATHS_ENABLED.store(value, Ordering::Relaxed);
 }
