diff --git a/core/src/avm2/activation.rs b/core/src/avm2/activation.rs
index 1129fa7b..adc335a8 100644
--- a/core/src/avm2/activation.rs
+++ b/core/src/avm2/activation.rs
@@ -703,12 +703,22 @@ impl<'a, 'gc> Activation<'a, 'gc> {
                     "native mismatch: {native:?}, поле {at}: нативно {mine}, байткодом {theirs}"
                 );
             }
-        } else if interpreted.as_i32() != result.as_i32() {
-            tracing::warn!(
-                "native mismatch: {native:?}, нативно {}, байткодом {}",
-                result.as_i32(),
-                interpreted.as_i32()
-            );
+        } else {
+            // Сравнение побитовое: методы столкновений возвращают дробное число, и физика решает
+            // по нему, есть касание или нет. Два NaN считаются одинаковыми.
+            let (mine, theirs) = (result.try_as_f64(), interpreted.try_as_f64());
+            let same = match (mine, theirs) {
+                (Some(mine), Some(theirs)) => {
+                    mine.to_bits() == theirs.to_bits() || (mine.is_nan() && theirs.is_nan())
+                }
+                (None, None) => true,
+                _ => false,
+            };
+            if !same {
+                tracing::warn!(
+                    "native mismatch: {native:?}, нативно {mine:?}, байткодом {theirs:?}"
+                );
+            }
         }
 
         Ok(*interpreted)
