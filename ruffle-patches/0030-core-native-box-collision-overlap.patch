         method
             .method_name()
-            .and_then(|name| crate::avm2::fast_paths::NativeMethod::from_name(&name))
-    } else {
-        None
-    };
+            .and_then(|name| crate::avm2::fast_paths::NativeMethod::from_name(&class_name, &name))
+    });
 
     // Раздача ячеек инлайн-кэша — после всех проходов оптимизатора: он успевает заменить часть
