+/// Какой из горячих методов узнан. Разбор делается один раз при верификации, чтобы в горячем
+/// цикле осталась одна проверка.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum NativeMethod {
+    /// Отсечение объекта по пирамиде видимости.
+    CullingInCamera,
+    /// Сборка матрицы объекта и умножение на родительскую.
+    ComposeAndAppend,
+    /// Обратная матрица объекта.
+    CalculateInverseMatrix,
+}
+
+impl NativeMethod {
+    /// Узнаёт метод по имени. Класс проверяется отдельно.
+    pub fn from_name(name: &str) -> Option<Self> {
+        match name {
+            "cullingInCamera" => Some(Self::CullingInCamera),
+            "composeAndAppend" => Some(Self::ComposeAndAppend),
+            "calculateInverseMatrix" => Some(Self::CalculateInverseMatrix),
+            _ => None,
+        }
+    }
+
+    /// Возвращает ли метод значение: у void-методов сверять нечего, кроме записанных полей.
+    pub fn returns_value(self) -> bool {
+        matches!(self, Self::CullingInCamera)
+    }
+}
 
