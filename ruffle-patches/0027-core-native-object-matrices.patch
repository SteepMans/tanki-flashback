+        e_imi: slot_of(activation, object, "imi", true)?,
+        e_imj: slot_of(activation, object, "imj", true)?,
+        e_imk: slot_of(activation, object, "imk", true)?,
+        e_iml: slot_of(activation, object, "iml", true)?,
+        e_ma: slot_of(activation, object, "ma", true)?,
+        e_mb: slot_of(activation, object, "mb", true)?,
