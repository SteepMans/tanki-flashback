+/// Прочитать числовое поле. `None` — значение не числовое: тогда нативный путь уступает байткоду.
+fn get<'gc>(_activation: &mut Activation<'_, 'gc>, object: Object<'gc>, slot: usize) -> Option<f64> {
+    object.get_slot(slot).try_as_f64()
+}
+
+/// Записать числовое поле.
+fn set<'gc>(object: Object<'gc>, slot: usize, value: f64, mc: &Mutation<'gc>) {
+    object.set_slot_no_coerce(slot, Value::Number(value), mc);
+}
+
+thread_local! {
+    /// Слоты матричных полей ищутся один раз, как и для отсечения.
+    static MATRIX_SLOTS: RefCell<Option<Option<MatrixSlots>>> = const { RefCell::new(None) };
+}
+
+/// Номера слотов матричных полей объекта сцены. Имена полей повторяют имена в движке (`ma`,
