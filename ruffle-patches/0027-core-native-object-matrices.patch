+        e_mh: slot_of(activation, object, "mh", true)?,
+        e_mi: slot_of(activation, object, "mi", true)?,
+        e_mj: slot_of(activation, object, "mj", true)?,
+        e_mk: slot_of(activation, object, "mk", true)?,
