@@ -680,6 +668,51 @@ impl<'a, 'gc> Activation<'a, 'gc> {
         result
     }
 
+    /// Режим сверки: метод считается и нативно, и байткодом с одного и того же входа, ответы
+    /// сравниваются, а игре отдаётся ответ байткода. Так совпадение доказывается на живой сцене,
+    /// а не берётся на веру. Медленно — включается только вручную со страницы.
+    fn run_actions_validating(
+        &mut self,
+        method: Method<'gc>,
+        native: crate::avm2::fast_paths::NativeMethod,
+    ) -> Result<Value<'gc>, Error<'gc>> {
+        let mut executed_ops = 0u64;
+
+        // Снимок того, что метод перезапишет: у методов без возвращаемого значения сверять больше
+        // нечего, а байткоду нужен тот же вход, что был у нативного счёта.
+        let before = crate::avm2::fast_paths::snapshot(self, native);
+        let Some(result) = crate::avm2::fast_paths::run(self, native) else {
+            return self.run_actions_inner(method, &mut executed_ops);
+        };
+        let native_wrote = crate::avm2::fast_paths::snapshot(self, native);
+        if let Some(before) = &before {
+            before.restore(self.gc());
+        }
+
+        let interpreted = self.run_actions_inner(method, &mut executed_ops);
+        let Ok(interpreted) = &interpreted else {
+            return interpreted;
+        };
+
+        if let Some(native_wrote) = &native_wrote {
+            if let Some(bytecode_wrote) = crate::avm2::fast_paths::snapshot(self, native)
+                && let Some((at, mine, theirs)) = native_wrote.mismatch(&bytecode_wrote)
+            {
+                tracing::warn!(
+                    "native mismatch: {native:?}, поле {at}: нативно {mine}, байткодом {theirs}"
+                );
+            }
+        } else if interpreted.as_i32() != result.as_i32() {
+            tracing::warn!(
+                "native mismatch: {native:?}, нативно {}, байткодом {}",
+                result.as_i32(),
+                interpreted.as_i32()
+            );
+        }
+
+        Ok(*interpreted)
+    }
+
     fn run_actions_inner(
         &mut self,
         method: Method<'gc>,
