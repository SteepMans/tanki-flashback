-                    if let Ok(interpreted) = &interpreted
-                        && interpreted.as_i32() != result.as_i32()
-                    {
-                        tracing::warn!(
-                            "culling mismatch: нативно {}, байткодом {}",
-                            result.as_i32(),
-                            interpreted.as_i32()
-                        );
-                    }
-                    return interpreted;
-                }
+            if crate::avm2::method_stats::validate_native_paths() {
