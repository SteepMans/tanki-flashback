+/// Снимок полей, которые метод перезаписывает. Нужен режиму сверки: метод ничего не возвращает,
+/// поэтому сравнить нативный счёт с байткодом можно только по записанному — а чтобы байткод считал
+/// с того же входа, снимок сначала откатывают.
+pub struct Snapshot<'gc> {
+    object: Object<'gc>,
+    slots: [usize; 12],
+    values: [f64; 12],
+}
+
+impl<'gc> Snapshot<'gc> {
+    /// Вернуть поля в состояние до нативного счёта.
+    pub fn restore(&self, mc: &Mutation<'gc>) {
+        for (slot, value) in self.slots.iter().zip(self.values.iter()) {
+            set(self.object, *slot, *value, mc);
+        }
+    }
+
+    /// Первое расхождение с другим снимком: номер поля и оба значения. Сравнение побитовое по
+    /// значению, но два NaN считаются одинаковыми — в матрице вырожденного объекта они законны.
+    pub fn mismatch(&self, other: &Self) -> Option<(usize, f64, f64)> {
+        for (at, (mine, theirs)) in self.values.iter().zip(other.values.iter()).enumerate() {
+            if mine != theirs && !(mine.is_nan() && theirs.is_nan()) {
+                return Some((at, *mine, *theirs));
+            }
+        }
+        None
+    }
+}
+
+/// Снять состояние полей, которые метод перезапишет. `None` — методу нечего снимать (отсечение
+/// сцены сверяется по возвращённому числу) или слоты не разобрались.
+pub fn snapshot<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    method: NativeMethod,
+) -> Option<Snapshot<'gc>> {
+    let object = activation.local_register(0).as_object()?;
+    let slots = matrix_slots(activation, object)?;
+    let slots = match method {
+        NativeMethod::CullingInCamera => return None,
+        NativeMethod::ComposeAndAppend => [
+            slots.e_ma,
+            slots.e_mb,
+            slots.e_mc,
+            slots.e_md,
+            slots.e_me,
+            slots.e_mf,
+            slots.e_mg,
+            slots.e_mh,
+            slots.e_mi,
+            slots.e_mj,
+            slots.e_mk,
+            slots.e_ml,
+        ],
+        NativeMethod::CalculateInverseMatrix => [
+            slots.e_ima,
+            slots.e_imb,
+            slots.e_imc,
+            slots.e_imd,
+            slots.e_ime,
+            slots.e_imf,
+            slots.e_img,
+            slots.e_imh,
+            slots.e_imi,
+            slots.e_imj,
+            slots.e_imk,
+            slots.e_iml,
+        ],
+    };
+
+    let mut values = [0.0f64; 12];
+    for (at, slot) in slots.iter().enumerate() {
+        values[at] = object.get_slot(*slot).try_as_f64()?;
+    }
+    Some(Snapshot {
+        object,
+        slots,
+        values,
+    })
+}
+
+/// Точка входа: считает узнанный метод нативно. `None` — случай не покрыт.
+pub fn run<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    method: NativeMethod,
+) -> Option<Value<'gc>> {
+    match method {
+        NativeMethod::CullingInCamera => culling_in_camera(activation),
+        NativeMethod::ComposeAndAppend => {
+            let this = activation.local_register(0).as_object()?;
+            let parent = activation.local_register(1).as_object()?;
+            let slots = matrix_slots(activation, this)?;
+            let mc = activation.gc();
+            compose_and_append(activation, this, parent, &slots, mc)?;
+            Some(Value::Undefined)
+        }
+        NativeMethod::CalculateInverseMatrix => {
+            let this = activation.local_register(0).as_object()?;
+            let slots = matrix_slots(activation, this)?;
+            let mc = activation.gc();
+            calculate_inverse_matrix(activation, this, &slots, mc)?;
+            Some(Value::Undefined)
+        }
+    }
+}
+
+fn matrix_slots<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    object: Object<'gc>,
+) -> Option<MatrixSlots> {
+    MATRIX_SLOTS.with(|cache| {
+        let mut cache = cache.borrow_mut();
+        if cache.is_none() {
+            *cache = Some(resolve_matrix_slots(activation, object));
+        }
+        *cache.as_ref().expect("только что заполнено")
+    })
+}
