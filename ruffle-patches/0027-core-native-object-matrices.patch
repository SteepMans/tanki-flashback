+
+/// `Object3D.composeAndAppend(parent)` — собрать матрицу объекта из поворотов, масштаба и
+/// положения и домножить на матрицу родителя. Тело переведено из байткода один в один, чтобы
+/// сохранить порядок умножений: в плавающей точке он влияет на последний бит. По той же причине
+/// скобки оставлены как есть, а не «упрощены» до читаемого вида.
+#[allow(unused_parens)]
+fn compose_and_append<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    this: Object<'gc>,
+    parent: Object<'gc>,
+    slots: &MatrixSlots,
+    mc: &Mutation<'gc>,
+) -> Option<()> {
+    let l7 = (get(activation, this, slots.p_rotationX)?).cos();
+    let l4 = (get(activation, this, slots.p_rotationX)?).sin();
+    let l3 = (get(activation, this, slots.p_rotationY)?).cos();
+    let l18 = (get(activation, this, slots.p_rotationY)?).sin();
+    let l8 = (get(activation, this, slots.p_rotationZ)?).cos();
+    let l25 = (get(activation, this, slots.p_rotationZ)?).sin();
+    let l26 = (l8 * l18);
+    let l5 = (l25 * l18);
+    let l6 = (l3 * get(activation, this, slots.p_scaleX)?);
+    let l9 = (l4 * get(activation, this, slots.p_scaleY)?);
+    let l22 = (l7 * get(activation, this, slots.p_scaleY)?);
+    let l24 = (l7 * get(activation, this, slots.p_scaleZ)?);
+    let l2 = (l4 * get(activation, this, slots.p_scaleZ)?);
+    let l10 = (l8 * l6);
+    let l11 = ((l26 * l9) - (l25 * l22));
+    let l12 = ((l26 * l24) + (l25 * l2));
+    let l13 = get(activation, this, slots.p_x)?;
+    let l14 = (l25 * l6);
+    let l15 = ((l5 * l9) + (l8 * l22));
+    let l16 = ((l5 * l24) - (l8 * l2));
+    let l17 = get(activation, this, slots.p_y)?;
+    let l19 = ((-(l18)) * get(activation, this, slots.p_scaleX)?);
+    let l20 = (l3 * l9);
+    let l21 = (l3 * l24);
+    let l23 = get(activation, this, slots.p_z)?;
+    set(this, slots.e_ma, (((get(activation, parent, slots.e_ma)? * l10) + (get(activation, parent, slots.e_mb)? * l14)) + (get(activation, parent, slots.e_mc)? * l19)), mc);
+    set(this, slots.e_mb, (((get(activation, parent, slots.e_ma)? * l11) + (get(activation, parent, slots.e_mb)? * l15)) + (get(activation, parent, slots.e_mc)? * l20)), mc);
+    set(this, slots.e_mc, (((get(activation, parent, slots.e_ma)? * l12) + (get(activation, parent, slots.e_mb)? * l16)) + (get(activation, parent, slots.e_mc)? * l21)), mc);
+    set(this, slots.e_md, ((((get(activation, parent, slots.e_ma)? * l13) + (get(activation, parent, slots.e_mb)? * l17)) + (get(activation, parent, slots.e_mc)? * l23)) + get(activation, parent, slots.e_md)?), mc);
+    set(this, slots.e_me, (((get(activation, parent, slots.e_me)? * l10) + (get(activation, parent, slots.e_mf)? * l14)) + (get(activation, parent, slots.e_mg)? * l19)), mc);
+    set(this, slots.e_mf, (((get(activation, parent, slots.e_me)? * l11) + (get(activation, parent, slots.e_mf)? * l15)) + (get(activation, parent, slots.e_mg)? * l20)), mc);
+    set(this, slots.e_mg, (((get(activation, parent, slots.e_me)? * l12) + (get(activation, parent, slots.e_mf)? * l16)) + (get(activation, parent, slots.e_mg)? * l21)), mc);
+    set(this, slots.e_mh, ((((get(activation, parent, slots.e_me)? * l13) + (get(activation, parent, slots.e_mf)? * l17)) + (get(activation, parent, slots.e_mg)? * l23)) + get(activation, parent, slots.e_mh)?), mc);
+    set(this, slots.e_mi, (((get(activation, parent, slots.e_mi)? * l10) + (get(activation, parent, slots.e_mj)? * l14)) + (get(activation, parent, slots.e_mk)? * l19)), mc);
+    set(this, slots.e_mj, (((get(activation, parent, slots.e_mi)? * l11) + (get(activation, parent, slots.e_mj)? * l15)) + (get(activation, parent, slots.e_mk)? * l20)), mc);
+    set(this, slots.e_mk, (((get(activation, parent, slots.e_mi)? * l12) + (get(activation, parent, slots.e_mj)? * l16)) + (get(activation, parent, slots.e_mk)? * l21)), mc);
+    set(this, slots.e_ml, ((((get(activation, parent, slots.e_mi)? * l13) + (get(activation, parent, slots.e_mj)? * l17)) + (get(activation, parent, slots.e_mk)? * l23)) + get(activation, parent, slots.e_ml)?), mc);
+    Some(())
+}
+
+/// `Object3D.calculateInverseMatrix()` — обратная матрица объекта. Как и выше, порядок действий
+/// и скобки — ровно те, что в байткоде.
+#[allow(unused_parens)]
+fn calculate_inverse_matrix<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    this: Object<'gc>,
+    slots: &MatrixSlots,
+    mc: &Mutation<'gc>,
+) -> Option<()> {
+    let l1 = (1.0 / ((((((((-(get(activation, this, slots.e_mc)?)) * get(activation, this, slots.e_mf)?) * get(activation, this, slots.e_mi)?) + ((get(activation, this, slots.e_mb)? * get(activation, this, slots.e_mg)?) * get(activation, this, slots.e_mi)?)) + ((get(activation, this, slots.e_mc)? * get(activation, this, slots.e_me)?) * get(activation, this, slots.e_mj)?)) - ((get(activation, this, slots.e_ma)? * get(activation, this, slots.e_mg)?) * get(activation, this, slots.e_mj)?)) - ((get(activation, this, slots.e_mb)? * get(activation, this, slots.e_me)?) * get(activation, this, slots.e_mk)?)) + ((get(activation, this, slots.e_ma)? * get(activation, this, slots.e_mf)?) * get(activation, this, slots.e_mk)?)));
+    set(this, slots.e_ima, ((((-(get(activation, this, slots.e_mg)?)) * get(activation, this, slots.e_mj)?) + (get(activation, this, slots.e_mf)? * get(activation, this, slots.e_mk)?)) * l1), mc);
