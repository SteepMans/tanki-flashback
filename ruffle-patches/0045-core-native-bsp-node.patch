+/// Номера слотов пула звеньев: статический список свободных на классе и `next` на звене.
+#[derive(Clone, Copy)]
+struct WrapperPoolSlots {
+    collector: usize,
+    next: usize,
+    wrapper_vtable: u32,
+}
+
+thread_local! {
+    static WRAPPER_POOL_SLOTS: RefCell<Option<(u32, WrapperPoolSlots)>> =
+        const { RefCell::new(None) };
+    static WRAPPER_POOL_HOPELESS: Cell<bool> = const { Cell::new(false) };
+}
+
+/// `Wrapper.create`/`createStatic` — выдача звена из списка свободных: шестьдесят пять тысяч
+/// вызовов в секунду при сборе прозрачной геометрии. Нативно распознаётся только непустой пул;
+/// пустой (нужен настоящий конструктор) уходит байткоду.
+fn wrapper_pool_slots<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    class_object: ClassObject<'gc>,
+    class_as_object: Object<'gc>,
+) -> Option<WrapperPoolSlots> {
+    let key = class_object.vtable().id();
+    if let Some((known, slots)) = WRAPPER_POOL_SLOTS.with(|cache| *cache.borrow())
+        && known == key
+    {
+        return Some(slots);
+    }
+    if WRAPPER_POOL_HOPELESS.with(|flag| flag.get()) {
+        return None;
+    }
+    let Some(collector) = slot_of(activation, class_as_object, "collector", true) else {
+        WRAPPER_POOL_HOPELESS.with(|flag| flag.set(true));
+        return None;
+    };
+    // next разбирается по живой голове пула: до первого возврата в пул её просто нет.
+    let head = class_as_object.get_slot(collector).as_object()?;
+    let Some(next) = slot_of(activation, head, "next", true) else {
+        WRAPPER_POOL_HOPELESS.with(|flag| flag.set(true));
+        return None;
+    };
+    let slots = WrapperPoolSlots {
+        collector,
+        next,
+        wrapper_vtable: head.vtable().id(),
+    };
+    WRAPPER_POOL_SLOTS.with(|cache| *cache.borrow_mut() = Some((key, slots)));
+    Some(slots)
+}
+
+fn wrapper_create<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    method: Method<'gc>,
+) -> Option<Value<'gc>> {
+    let class_object = declaring_class(method)?;
+    let class_as_object: Object<'gc> = class_object.into();
+    let slots = wrapper_pool_slots(activation, class_object, class_as_object)?;
+
+    let head = class_as_object.get_slot(slots.collector).as_object()?;
+    if head.vtable().id() != slots.wrapper_vtable {
+        return None;
+    }
+    let mc = activation.gc();
+    let next = head.get_slot(slots.next);
+    class_as_object.set_slot_no_coerce(slots.collector, next, mc);
+    head.set_slot_no_coerce(slots.next, Value::Null, mc);
+    Some(Value::Object(head))
+}
