From 3a53d40253368af4b879a12bca3f055c4101537f Mon Sep 17 00:00:00 2001
From: Konstantin <38701987+SteepMans@users.noreply.github.com>
Date: Tue, 18 Aug 2026 11:19:28 +0300
Subject: [PATCH 2/3] core: native paint texture padding, skipped in validation
 mode

---
 core/src/avm2/activation.rs |  13 ++--
 core/src/avm2/fast_paths.rs | 117 +++++++++++++++++++++++++++++++++++-
 2 files changed, 124 insertions(+), 6 deletions(-)

diff --git a/core/src/avm2/activation.rs b/core/src/avm2/activation.rs
index d936c279..fbb91ec5 100644
--- a/core/src/avm2/activation.rs
+++ b/core/src/avm2/activation.rs
@@ -672,13 +672,16 @@ impl<'a, 'gc> Activation<'a, 'gc> {
             && crate::avm2::method_stats::native_paths_enabled()
         {
             if crate::avm2::method_stats::validate_native_paths() {
-                return self.run_actions_validating(method, native);
-            }
-            // Перевод, ещё не доказавший совпадение на живом бою, исполняется только в режиме
-            // сверки — обычный запуск идёт байткодом.
-            if !native.validate_only()
+                // Несравнимая замена (уничтожает вход) в режиме сверки не запускается вовсе —
+                // считает байткод, чтобы прогон со сверкой оставался эталонным.
+                if native.comparable() {
+                    return self.run_actions_validating(method, native);
+                }
+            } else if !native.validate_only()
                 && let Some(result) = crate::avm2::fast_paths::run(self, native, method)
             {
+                // Перевод, ещё не доказавший совпадение на живом бою, исполняется только в
+                // режиме сверки — обычный запуск идёт байткодом.
                 return Ok(result);
             }
         }
diff --git a/core/src/avm2/fast_paths.rs b/core/src/avm2/fast_paths.rs
index acb910d9..80e35868 100644
--- a/core/src/avm2/fast_paths.rs
+++ b/core/src/avm2/fast_paths.rs
@@ -86,6 +86,8 @@ pub enum NativeMethod {
