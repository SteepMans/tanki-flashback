 }
 
 impl NativeMethod {
@@ -114,6 +116,9 @@ impl NativeMethod {
             ("Wrapper", "create") | ("Wrapper", "createStatic") => Some(Self::WrapperCreate),
             ("ConflictContainer", "e48c6fdc") => Some(Self::ConflictClip),
             ("Camera3D", "sortByAverageZ") => Some(Self::SortByAverageZ),
+            // Утилита текстур покраски в library.swf: класс обфусцирован, имя метода — из
