     /// Метод исполняется нативно только в режиме сверки: перевод готов, но по умолчанию не
     /// включается, пока живой бой не покажет ноль расхождений с байткодом.
     pub fn validate_only(self) -> bool {
-        matches!(self, Self::CalculateOobb)
+        // Освещение спрайта на стендовой карте не исполняется, поэтому стендом не сверено:
