+/// Двенадцать значений матрицы объекта, собранной из его углов, масштаба и позиции — общая
+/// часть composeMatrix, composeMatrixFromSource и composeAndAppend. Порядок операций байткодный,
+/// имена промежуточных повторяют байткодные локали composeAndAppend.
+#[allow(unused_parens)]
+fn compose_values<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    source: Object<'gc>,
+    slots: &MatrixSlots,
+) -> Option<[f64; 12]> {
+    let l7 = (get(activation, source, slots.p_rotationX)?).cos();
+    let l4 = (get(activation, source, slots.p_rotationX)?).sin();
+    let l3 = (get(activation, source, slots.p_rotationY)?).cos();
+    let l18 = (get(activation, source, slots.p_rotationY)?).sin();
+    let l8 = (get(activation, source, slots.p_rotationZ)?).cos();
+    let l25 = (get(activation, source, slots.p_rotationZ)?).sin();
+    let l26 = (l8 * l18);
+    let l5 = (l25 * l18);
+    let l6 = (l3 * get(activation, source, slots.p_scaleX)?);
+    let l9 = (l4 * get(activation, source, slots.p_scaleY)?);
+    let l22 = (l7 * get(activation, source, slots.p_scaleY)?);
+    let l24 = (l7 * get(activation, source, slots.p_scaleZ)?);
+    let l2 = (l4 * get(activation, source, slots.p_scaleZ)?);
+    Some([
+        (l8 * l6),
+        ((l26 * l9) - (l25 * l22)),
+        ((l26 * l24) + (l25 * l2)),
+        get(activation, source, slots.p_x)?,
+        (l25 * l6),
+        ((l5 * l9) + (l8 * l22)),
+        ((l5 * l24) - (l8 * l2)),
+        get(activation, source, slots.p_y)?,
+        ((-(l18)) * get(activation, source, slots.p_scaleX)?),
+        (l3 * l9),
+        (l3 * l24),
+        get(activation, source, slots.p_z)?,
+    ])
+}
+
+/// Запись двенадцати значений в ma..ml объекта.
+fn write_matrix<'gc>(
+    object: Object<'gc>,
+    slots: &MatrixSlots,
+    values: &[f64; 12],
+    mc: &Mutation<'gc>,
+) {
+    let places = [
+        slots.e_ma, slots.e_mb, slots.e_mc, slots.e_md, slots.e_me, slots.e_mf, slots.e_mg,
+        slots.e_mh, slots.e_mi, slots.e_mj, slots.e_mk, slots.e_ml,
+    ];
+    for (slot, value) in places.iter().zip(values.iter()) {
+        set(object, *slot, *value, mc);
+    }
+}
+
+/// Чтение двенадцати значений ma..ml объекта.
+fn read_matrix<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    object: Object<'gc>,
+    slots: &MatrixSlots,
+) -> Option<[f64; 12]> {
+    Some([
+        get(activation, object, slots.e_ma)?,
+        get(activation, object, slots.e_mb)?,
+        get(activation, object, slots.e_mc)?,
+        get(activation, object, slots.e_md)?,
+        get(activation, object, slots.e_me)?,
+        get(activation, object, slots.e_mf)?,
+        get(activation, object, slots.e_mg)?,
+        get(activation, object, slots.e_mh)?,
+        get(activation, object, slots.e_mi)?,
+        get(activation, object, slots.e_mj)?,
+        get(activation, object, slots.e_mk)?,
+        get(activation, object, slots.e_ml)?,
+    ])
+}
+
+/// `Object3D.invertMatrix()` — обращение матрицы на месте. Формулы — те же, что у
+/// calculateInverseMatrix, но байткод сперва снимает все двенадцать значений в локали и пишет
+/// результат обратно в ma..ml.
+#[allow(unused_parens)]
+fn invert_matrix_in_place<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    this: Object<'gc>,
+    slots: &MatrixSlots,
+) -> Option<()> {
+    let [ma, mb, mc_, md, me, mf, mg, mh, mi, mj, mk, ml] = read_matrix(activation, this, slots)?;
+    let d = (1.0
+        / ((((((((-(mc_)) * mf) * mi) + ((mb * mg) * mi)) + ((mc_ * me) * mj))
+            - ((ma * mg) * mj))
+            - ((mb * me) * mk))
+            + ((ma * mf) * mk)));
+    let mc = activation.gc();
+    set(this, slots.e_ma, ((((-(mg)) * mj) + (mf * mk)) * d), mc);
+    set(this, slots.e_mb, (((mc_ * mj) - (mb * mk)) * d), mc);
+    set(this, slots.e_mc, ((((-(mc_)) * mf) + (mb * mg)) * d), mc);
+    set(
+        this,
+        slots.e_md,
+        ((((((((md * mg) * mj) - ((mc_ * mh) * mj)) - ((md * mf) * mk)) + ((mb * mh) * mk))
+            + ((mc_ * mf) * ml))
+            - ((mb * mg) * ml))
+            * d),
+        mc,
+    );
+    set(this, slots.e_me, (((mg * mi) - (me * mk)) * d), mc);
+    set(this, slots.e_mf, ((((-(mc_)) * mi) + (ma * mk)) * d), mc);
+    set(this, slots.e_mg, (((mc_ * me) - (ma * mg)) * d), mc);
+    set(
+        this,
+        slots.e_mh,
+        ((((((((mc_ * mh) * mi) - ((md * mg) * mi)) + ((md * me) * mk)) - ((ma * mh) * mk))
+            - ((mc_ * me) * ml))
+            + ((ma * mg) * ml))
+            * d),
+        mc,
+    );
+    set(this, slots.e_mi, ((((-(mf)) * mi) + (me * mj)) * d), mc);
+    set(this, slots.e_mj, (((mb * mi) - (ma * mj)) * d), mc);
+    set(this, slots.e_mk, ((((-(mb)) * me) + (ma * mf)) * d), mc);
+    set(
+        this,
+        slots.e_ml,
+        ((((((((md * mf) * mi) - ((mb * mh) * mi)) - ((md * me) * mj)) + ((ma * mh) * mj))
+            + ((mb * me) * ml))
+            - ((ma * mf) * ml))
+            * d),
+        mc,
+    );
+    Some(())
+}
+
+/// `Object3D.appendMatrix(outer)` — домножение слева: this.m = outer.m × this.m. Байткод сперва
+/// снимает свою матрицу в локали; при this == outer его строки читали бы уже переписанные
+/// значения — такой вызов уступается интерпретатору ради дословности.
+#[allow(unused_parens)]
+fn append_matrix<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    this: Object<'gc>,
+    outer: Object<'gc>,
+    slots: &MatrixSlots,
+) -> Option<()> {
+    if Object::ptr_eq(this, outer) {
+        return None;
+    }
+    let [l2, l3, l4, l5, l6, l7, l8, l9, l10, l11, l12, l13] =
+        read_matrix(activation, this, slots)?;
+    let [a_ma, a_mb, a_mc, a_md, a_me, a_mf, a_mg, a_mh, a_mi, a_mj, a_mk, a_ml] =
+        read_matrix(activation, outer, slots)?;
+    let mc = activation.gc();
+    set(this, slots.e_ma, (((a_ma * l2) + (a_mb * l6)) + (a_mc * l10)), mc);
+    set(this, slots.e_mb, (((a_ma * l3) + (a_mb * l7)) + (a_mc * l11)), mc);
+    set(this, slots.e_mc, (((a_ma * l4) + (a_mb * l8)) + (a_mc * l12)), mc);
+    set(this, slots.e_md, ((((a_ma * l5) + (a_mb * l9)) + (a_mc * l13)) + a_md), mc);
+    set(this, slots.e_me, (((a_me * l2) + (a_mf * l6)) + (a_mg * l10)), mc);
+    set(this, slots.e_mf, (((a_me * l3) + (a_mf * l7)) + (a_mg * l11)), mc);
+    set(this, slots.e_mg, (((a_me * l4) + (a_mf * l8)) + (a_mg * l12)), mc);
+    set(this, slots.e_mh, ((((a_me * l5) + (a_mf * l9)) + (a_mg * l13)) + a_mh), mc);
+    set(this, slots.e_mi, (((a_mi * l2) + (a_mj * l6)) + (a_mk * l10)), mc);
+    set(this, slots.e_mj, (((a_mi * l3) + (a_mj * l7)) + (a_mk * l11)), mc);
+    set(this, slots.e_mk, (((a_mi * l4) + (a_mj * l8)) + (a_mk * l12)), mc);
+    set(this, slots.e_ml, ((((a_mi * l5) + (a_mj * l9)) + (a_mk * l13)) + a_ml), mc);
+    Some(())
+}
+
+/// Номер метода по одному лишь имени — для приватных методов, чьё пространство имён снаружи не
+/// построить. Как и слоты, имена в классе единственны.
+fn method_by_local_name<'gc>(object: Object<'gc>, name: &str) -> Option<usize> {
+    object
+        .vtable()
+        .resolved_traits()
+        .iter()
+        .find_map(|(local, _, property)| match property {
+            Property::Method { disp_id, .. } if &*local.to_utf8_lossy() == name => {
+                Some(*disp_id as usize)
+            }
+            _ => None,
+        })
+}
+
+/// Слоты видимости тени (`Shadow.checkVisibility`). Shadow — самостоятельный класс (не Object3D),
+/// его границы и флаг камеры внутри — свои поля.
+#[derive(Clone, Copy)]
+struct ShadowVisSlots {
+    shadow_vtable: u32,
+    camera_vtable: u32,
+    vertex_vtable: u32,
+    /// Приватные поля тени: счётчик кастеров, направление-вектор, объект света, вектор кастеров,
+    /// голова списка вершин границ, размер текселя и левый нижний угол карты, минимальная глубина.
+    s_count: usize,
+    s_direction: usize,
+    s_dirvec: usize,
+    s_light: usize,
+    s_casters: usize,
+    s_bound_list: usize,
+    s_map_size: usize,
+    s_blur: usize,
+    s_offset: usize,
+    s_attenuation: usize,
+    s_far_distance: usize,
+    s_min_z: usize,
+    s_texel: usize,
+    s_left: usize,
+    s_bottom: usize,
+    s_bound: [usize; 6],
+    s_camera_inside: usize,
+    /// Границы и родитель на объектах сцены (свет и кастеры — наследники Object3D).
+    o_bound: [usize; 6],
+    o_parent: usize,
+    /// Вершина списка границ: координаты, ссылка дальше, камерные координаты.
+    v_xyz: [usize; 3],
+    v_next: usize,
+    v_cam: [usize; 3],
+    /// Камера: дальняя и ближняя плоскости, множитель дистанции теней, глобальная позиция.
+    c_far: usize,
+    c_near: usize,
+    c_sdm: usize,
+    c_gm: [usize; 3],
+    /// Приватное отсечение тени камерой — считается интерпретатором.
+    culling_disp: usize,
+}
+
+thread_local! {
+    static SHADOW_VIS_SLOTS: RefCell<Option<ShadowVisSlots>> = const { RefCell::new(None) };
+    static SHADOW_VIS_HOPELESS: Cell<bool> = const { Cell::new(false) };
+}
+
+/// Класс Object3D по цепочке предков экземпляра: нужен и как ключ кэша матричных слотов (тот же,
+/// что у composeAndAppend), и ради статического tA.
+fn object3d_class_of<'gc>(sample: Object<'gc>) -> Option<crate::avm2::object::ClassObject<'gc>> {
+    let mut class = sample.instance_class();
+    loop {
+        if &*class.name().local_name().to_utf8_lossy() == ENGINE_CLASS {
+            return class.class_object();
+        }
+        class = class.super_class()?;
+    }
+}
+
+fn shadow_vis_slots<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    shadow: Object<'gc>,
+    camera: Object<'gc>,
+    light: Object<'gc>,
+    vertex: Object<'gc>,
+) -> Option<ShadowVisSlots> {
+    if let Some(slots) = SHADOW_VIS_SLOTS.with(|cache| *cache.borrow()) {
+        if shadow.vtable().id() == slots.shadow_vtable
+            && camera.vtable().id() == slots.camera_vtable
+        {
+            return Some(slots);
+        }
+        return None;
+    }
+    if SHADOW_VIS_HOPELESS.with(|flag| flag.get()) {
+        return None;
+    }
+    let resolve = |activation: &mut Activation<'_, 'gc>| -> Option<ShadowVisSlots> {
+        Some(ShadowVisSlots {
+            shadow_vtable: shadow.vtable().id(),
+            camera_vtable: camera.vtable().id(),
+            vertex_vtable: vertex.vtable().id(),
+            s_count: slot_by_local_name(shadow, "e58516dc")?,
+            s_direction: slot_of(activation, shadow, "direction", false)?,
+            s_dirvec: slot_by_local_name(shadow, "f143e037")?,
+            s_light: slot_by_local_name(shadow, "light")?,
+            s_casters: slot_by_local_name(shadow, "a1b6c041")?,
+            s_bound_list: slot_by_local_name(shadow, "boundVertexList")?,
+            s_map_size: slot_of(activation, shadow, "mapSize", false)?,
+            s_blur: slot_of(activation, shadow, "blur", false)?,
+            s_offset: slot_of(activation, shadow, "offset", false)?,
+            s_attenuation: slot_of(activation, shadow, "attenuation", false)?,
+            s_far_distance: slot_of(activation, shadow, "farDistance", false)?,
+            s_min_z: slot_by_local_name(shadow, "minZ")?,
+            s_texel: slot_by_local_name(shadow, "f33f76d7")?,
+            s_left: slot_by_local_name(shadow, "d1ab29a0")?,
+            s_bottom: slot_by_local_name(shadow, "f46509b3")?,
+            s_bound: [
+                slot_of(activation, shadow, "boundMinX", true)?,
+                slot_of(activation, shadow, "boundMinY", true)?,
+                slot_of(activation, shadow, "boundMinZ", true)?,
+                slot_of(activation, shadow, "boundMaxX", true)?,
+                slot_of(activation, shadow, "boundMaxY", true)?,
+                slot_of(activation, shadow, "boundMaxZ", true)?,
+            ],
+            s_camera_inside: slot_of(activation, shadow, "cameraInside", true)?,
+            o_bound: [
+                slot_of(activation, light, "boundMinX", false)?,
+                slot_of(activation, light, "boundMinY", false)?,
+                slot_of(activation, light, "boundMinZ", false)?,
+                slot_of(activation, light, "boundMaxX", false)?,
+                slot_of(activation, light, "boundMaxY", false)?,
+                slot_of(activation, light, "boundMaxZ", false)?,
+            ],
+            o_parent: slot_of(activation, light, "_parent", true)?,
+            v_xyz: [
+                slot_of(activation, vertex, "x", false)?,
+                slot_of(activation, vertex, "y", false)?,
+                slot_of(activation, vertex, "z", false)?,
+            ],
+            v_next: slot_of(activation, vertex, "next", true)?,
+            v_cam: [
+                slot_of(activation, vertex, "cameraX", true)?,
+                slot_of(activation, vertex, "cameraY", true)?,
+                slot_of(activation, vertex, "cameraZ", true)?,
+            ],
+            c_far: slot_of(activation, camera, "farClipping", false)?,
+            c_near: slot_of(activation, camera, "nearClipping", false)?,
+            c_sdm: slot_of(activation, camera, "shadowsDistanceMultiplier", false)?,
+            c_gm: [
+                slot_of(activation, camera, "gmd", true)?,
+                slot_of(activation, camera, "gmh", true)?,
+                slot_of(activation, camera, "gml", true)?,
+            ],
+            culling_disp: method_by_local_name(shadow, "cullingInCamera")?,
+        })
+    };
+    match resolve(activation) {
+        Some(slots) => {
+            SHADOW_VIS_SLOTS.with(|cache| *cache.borrow_mut() = Some(slots));
+            Some(slots)
+        }
+        None => {
+            SHADOW_VIS_HOPELESS.with(|flag| flag.set(true));
+            None
+        }
+    }
+}
+
+/// `Shadow.checkVisibility(camera)` — матрица света из направления, обход кастеров с гранями
+/// их ограничивающих коробок, отсечение камерой и границы тени. Кадры владельца отдавали этому
+/// пути три-восемь процентов; тяжесть — в матричных листьях и отсечении, но и сам обход переведён.
+///
+/// Приватное cullingInCamera считает интерпретатор через вызов по номеру метода; его исключение
+/// уходит дальше как есть, без отката — байткод вёл бы себя так же. Замена несравнима: поля света,
+/// вершин и самой тени переписываются по ходу.
+#[allow(unused_parens)]
+fn shadow_check_visibility<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    method: Method<'gc>,
+) -> Result<Option<Value<'gc>>, crate::avm2::Error<'gc>> {
+    let _ = method;
+    let Some(this) = activation.local_register(0).as_object() else {
+        return Ok(None);
+    };
+    let Some(camera) = activation.local_register(1).as_object() else {
+        return Ok(None);
+    };
+
+    // Прескан: все объекты и слоты на месте; до первой записи любой сход — в интерпретатор.
+    let Some(light_probe) = SHADOW_VIS_SLOTS
+        .with(|cache| cache.borrow().map(|slots| slots.s_light))
+        .map(|slot| this.get_slot(slot).as_object())
+        .unwrap_or_else(|| {
+            // Слотов ещё нет: найдём поле света перебором один раз, резолв ниже закэширует всё.
+            slot_by_local_name(this, "light").and_then(|slot| this.get_slot(slot).as_object())
+        })
+    else {
+        return Ok(None);
+    };
+    let Some(vertex_probe) = slot_by_local_name(this, "boundVertexList")
+        .and_then(|slot| this.get_slot(slot).as_object())
+    else {
+        return Ok(None);
+    };
+    let Some(slots) = shadow_vis_slots(activation, this, camera, light_probe, vertex_probe)
+    else {
+        return Ok(None);
+    };
+
+    let count_value = this.get_slot(slots.s_count).try_as_f64().unwrap_or(f64::NAN);
+    if count_value == 0.0 {
+        return Ok(Some(Value::Bool(false)));
+    }
+    if !(count_value > 0.0) || count_value.fract() != 0.0 || count_value > 100_000.0 {
+        return Ok(None);
+    }
+    let count = count_value as usize;
+
+    let Some(dirvec) = this.get_slot(slots.s_dirvec).as_object() else {
+        return Ok(None);
+    };
+    let Some(v3) = vector3d_slots(activation, dirvec) else {
+        return Ok(None);
+    };
+    let direction = this.get_slot(slots.s_direction).as_object();
+    if let Some(direction) = direction
+        && direction.vtable().id() != v3.vtable
+    {
+        return Ok(None);
+    }
+    let Some(light) = this.get_slot(slots.s_light).as_object() else {
+        return Ok(None);
+    };
+    let Some(object3d_class) = object3d_class_of(light) else {
+        return Ok(None);
+    };
+    let Some(matrix) = matrix_slots(activation, object3d_class, light) else {
+        return Ok(None);
+    };
+    let object3d_class_object: Object<'gc> = object3d_class.into();
+    let Some(ta_slot) = slot_by_local_name(object3d_class_object, "tA") else {
+        return Ok(None);
+    };
