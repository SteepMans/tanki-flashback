 7 files changed, 216 insertions(+), 6 deletions(-)

diff --git a/core/src/avm2/activation.rs b/core/src/avm2/activation.rs
index 5ebc6a23..6d285612 100644
--- a/core/src/avm2/activation.rs
+++ b/core/src/avm2/activation.rs
@@ -670,13 +670,16 @@ impl<'a, 'gc> Activation<'a, 'gc> {
         // Читаем флаг один раз на метод: ветка по локальной переменной предсказуема и почти
         // бесплатна, а атомарное чтение на каждую инструкцию заметно бы стоило.
         let trace_ops = crate::avm2::method_stats::ops_enabled();
+        let mut prev_kind = crate::avm2::method_stats::OP_KINDS.len() - 1;
 
         loop {
             let op = &opcodes[ip];
             ip += 1;
             *executed_ops += 1;
             if trace_ops {
-                crate::avm2::method_stats::record_op(crate::avm2::method_stats::op_kind(op));
+                let kind = crate::avm2::method_stats::op_kind(op);
+                crate::avm2::method_stats::record_op(kind, prev_kind);
+                prev_kind = kind;
             }
             avm_debug!(self.avm2(), "Opcode: {op:?}");
 
@@ -693,6 +696,15 @@ impl<'a, 'gc> Activation<'a, 'gc> {
                 Op::Pop => self.op_pop(),
                 Op::Dup => self.op_dup(),
                 Op::GetLocal { index } => self.op_get_local(*index),
+                Op::GetLocal2 { first, second } => self.op_get_local2(*first, *second),
+                Op::GetLocalSlot {
+                    local_index,
+                    slot_index,
+                } => self.op_get_local_slot(*local_index, *slot_index),
+                Op::MultiplyLocalSlot {
+                    local_index,
+                    slot_index,
+                } => self.op_multiply_local_slot(*local_index, *slot_index),
                 Op::SetLocal { index } => self.op_set_local(*index),
                 Op::StoreLocal { index } => self.op_store_local(*index),
