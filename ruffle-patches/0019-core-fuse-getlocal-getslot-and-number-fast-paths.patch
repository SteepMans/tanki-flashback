-/// Учитывает выполненную инструкцию. Вызывается только при включённом счётчике.
-pub fn record_op(kind: usize) {
+/// Учитывает выполненную инструкцию и пару «предыдущая-текущая».
+pub fn record_op(kind: usize, prev: usize) {
     OPS.with(|ops| {
         let cell = &ops[kind];
         cell.set(cell.get() + 1);
     });
+    PAIRS.with(|pairs| {
+        let cell = &pairs[prev * OP_KINDS.len() + kind];
+        cell.set(cell.get() + 1);
+    });
+}
+
+/// Верхушка по парам инструкций; счётчики обнуляются.
+pub fn take_pairs(limit: usize) -> Vec<(String, u64)> {
+    PAIRS.with(|pairs| {
+        let mut rows: Vec<_> = pairs
+            .iter()
+            .enumerate()
+            .map(|(i, cell)| (i, cell.replace(0)))
+            .filter(|(_, count)| *count > 0)
+            .map(|(i, count)| {
+                (format!("{} -> {}", OP_KINDS[i / OP_KINDS.len()], OP_KINDS[i % OP_KINDS.len()]), count)
+            })
+            .collect();
+        rows.sort_by(|a, b| b.1.cmp(&a.1));
+        rows.truncate(limit);
+        rows
+    })
 }
 
