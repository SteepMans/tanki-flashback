@@ -1046,6 +1058,57 @@ impl<'a, 'gc> Activation<'a, 'gc> {
         Ok(())
     }
 
+    /// `getlocal`+`getlocal` одной инструкцией.
+    fn op_get_local2(&mut self, first: u32, second: u32) -> Result<(), Error<'gc>> {
+        let first = self.local_register(first);
+        let second = self.local_register(second);
+        self.push_stack(first);
+        self.push_stack(second);
+
+        Ok(())
+    }
+
+    /// `getlocal`+`getslot` одной инструкцией: значение не проходит через стек лишний раз.
+    fn op_get_local_slot(&mut self, register_index: u32, index: usize) -> Result<(), Error<'gc>> {
+        let object = self
+            .local_register(register_index)
+            .null_check(self, None)?
+            .as_object()
+            .expect("Cannot get_slot on primitive");
+
+        self.push_stack(object.get_slot(index));
+
+        Ok(())
+    }
+
+    /// `getlocal`+`getslot`+`multiply` одной инструкцией: поле не проходит через стек.
+    fn op_multiply_local_slot(&mut self, register_index: u32, index: usize) -> Result<(), Error<'gc>> {
+        let object = self
+            .local_register(register_index)
+            .null_check(self, None)?
+            .as_object()
+            .expect("Cannot get_slot on primitive");
+        let value2 = object.get_slot(index);
+        let value1 = self.pop_stack();
+
+        if let (Value::Number(n1), Value::Number(n2)) = (value1, value2) {
+            self.push_stack(n1 * n2);
+            return Ok(());
+        }
+        if let (Value::Integer(n1), Value::Integer(n2)) = (value1, value2)
+            && let Some(result) = n1.checked_mul(n2)
+        {
+            self.push_stack(result);
+            return Ok(());
+        }
+
+        let value2 = value2.coerce_to_number(self)?;
+        let value1 = value1.coerce_to_number(self)?;
+        self.push_stack(value1 * value2);
+
+        Ok(())
+    }
+
     fn op_set_local(&mut self, register_index: u32) -> Result<(), Error<'gc>> {
         let value = self.pop_stack();
 
@@ -2185,8 +2248,17 @@ impl<'a, 'gc> Activation<'a, 'gc> {
     }
 
     fn op_divide(&mut self) -> Result<(), Error<'gc>> {
-        let value2 = self.pop_stack().coerce_to_number(self)?;
-        let value1 = self.pop_stack().coerce_to_number(self)?;
+        let raw2 = self.pop_stack();
+        let raw1 = self.pop_stack();
+
+        // Тот же быстрый путь, что и в умножении.
+        if let (Value::Number(n1), Value::Number(n2)) = (raw1, raw2) {
+            self.push_stack(Value::from(n1 / n2).try_promote_number());
+            return Ok(());
+        }
+
+        let value2 = raw2.coerce_to_number(self)?;
+        let value1 = raw1.coerce_to_number(self)?;
         let result = Value::from(value1 / value2);
 
         self.push_stack(result.try_promote_number());
@@ -2259,6 +2331,12 @@ impl<'a, 'gc> Activation<'a, 'gc> {
             self.push_stack(result);
             return Ok(());
         }
+        // Два дробных числа — самый частый случай в математике движка: считаем сразу, минуя
+        // общее приведение (оно принимает &mut self и не встраивается).
+        if let (Value::Number(n1), Value::Number(n2)) = (value1, value2) {
+            self.push_stack(n1 * n2);
+            return Ok(());
+        }
         let value2 = value2.coerce_to_number(self)?;
         let value1 = value1.coerce_to_number(self)?;
         self.push_stack(value1 * value2);
