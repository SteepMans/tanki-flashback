@@ -316,6 +318,21 @@ pub fn reset_frame() {
     FRAME.with(|frame| frame.borrow_mut().clear());
 }
 
+/// Какие нативные замены режим сверки действительно сравнил с байткодом. Без этого списка «ноль
+/// расхождений» ничего не значит: замена могла ни разу не сработать, и сравнивать было нечего.
+pub fn record_validated(name: &str) {
+    VALIDATED.with(|validated| {
+        let mut validated = validated.borrow_mut();
+        if !validated.iter().any(|known| known == name) {
+            validated.push(name.to_owned());
+        }
+    });
+}
+
+pub fn validated_methods() -> Vec<String> {
+    VALIDATED.with(|validated| validated.borrow().clone())
