     static CACHE_HITS: Cell<u64> = const { Cell::new(0) };
     static CACHE_MISSES: Cell<u64> = const { Cell::new(0) };
+    /// Имена нативных замен, чьи ответы режим сверки успел сравнить с байткодом.
+    static VALIDATED: RefCell<Vec<String>> = const { RefCell::new(Vec::new()) };
     /// Метод -> (инструкций, вызовов). Ключ — адрес метода, а не имя: счётчик обновляется на
     /// КАЖДОМ вызове (у клиента около миллиона в секунду), и сборка имени строкой стоила там
