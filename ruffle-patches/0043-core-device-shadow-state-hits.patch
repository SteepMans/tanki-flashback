+/// Равенство в духе `==` байткода для значений, которые лежат в теневых наборах устройства:
+/// объекты сравниваются по тождеству, null и undefined равны друг другу, числа — по значению,
+/// строки — по содержимому. `None` — сочетание типов, за которое ручаться нельзя: пусть сравнивает
+/// интерпретатор.
+fn shadow_equals<'gc>(mine: Value<'gc>, theirs: Value<'gc>) -> Option<bool> {
+    match (mine, theirs) {
+        (Value::Object(mine), Value::Object(theirs)) => Some(Object::ptr_eq(mine, theirs)),
+        (Value::Null | Value::Undefined, Value::Null | Value::Undefined) => Some(true),
+        (Value::Object(_), Value::Null | Value::Undefined)
+        | (Value::Null | Value::Undefined, Value::Object(_)) => Some(false),
+        (Value::Integer(mine), Value::Integer(theirs)) => Some(mine == theirs),
+        (Value::Number(mine), Value::Number(theirs)) => Some(mine == theirs),
+        (Value::Integer(mine), Value::Number(theirs)) => Some(f64::from(mine) == theirs),
+        (Value::Number(mine), Value::Integer(theirs)) => Some(mine == f64::from(theirs)),
+        (Value::String(mine), Value::String(theirs)) => Some(mine == theirs),
+        (Value::String(_), Value::Null | Value::Undefined)
+        | (Value::Null | Value::Undefined, Value::String(_)) => Some(false),
+        _ => None,
+    }
+}
+
+/// Элемент теневого вектора по номеру сэмплера или потока. `None` — номер вне вектора: байткод
+/// на таком бросил бы RangeError, пусть бросает сам.
+fn shadow_element<'gc>(
+    state: Object<'gc>,
+    slot: usize,
+    index: i32,
+) -> Option<Value<'gc>> {
+    let vector = state.get_slot(slot).as_object()?;
+    let storage = vector.as_vector_storage()?;
+    if index < 0 || index as usize >= storage.length() {
+        return None;
+    }
+    storage.get_optional(index as usize)
+}
+
+/// `Device.setTextureAt` — обёртка движка над Stage3D с теневым состоянием: если сэмплеру уже
+/// назначен тот же ресурс, делать нечего. В бою таких вызовов под восемьдесят тысяч в секунду, и
+/// почти все — попадания в теневой кэш. Здесь нативно распознаётся только попадание; любой промах
+/// уходит байткоду, который заново сравнит и сделает всю работу.
+fn set_texture_at<'gc>(activation: &mut Activation<'_, 'gc>) -> Option<Value<'gc>> {
+    let this = activation.local_register(0).as_object()?;
+    let index = match activation.local_register(1) {
+        Value::Integer(value) => value,
+        _ => return None,
+    };
+    let resource = activation.local_register(2);
+
+    let slots = device_slots(activation, this)?;
+    let state = this.get_slot(slots.render_state).as_object()?;
+    let element = shadow_element(state, slots.textures, index)?;
+    if shadow_equals(resource, element)? {
+        return Some(Value::Undefined);
+    }
+    None
+}
+
+/// `Device.setVertexBufferAt` — та же обёртка для вершинных потоков: буфер, смещение и формат
+/// сравниваются с теневыми наборами, совпадение всех трёх значит «ничего не делать».
+fn set_vertex_buffer_at<'gc>(activation: &mut Activation<'_, 'gc>) -> Option<Value<'gc>> {
+    let this = activation.local_register(0).as_object()?;
+    let index = match activation.local_register(1) {
+        Value::Integer(value) => value,
+        _ => return None,
+    };
+    let buffer = activation.local_register(2);
+    let offset = activation.local_register(3);
+    let format = activation.local_register(4);
+
+    let slots = device_slots(activation, this)?;
+    let state = this.get_slot(slots.render_state).as_object()?;
+    let same_buffer = shadow_equals(
+        buffer,
+        shadow_element(state, slots.vertex_buffers, index)?,
+    )?;
+    let same_offset = shadow_equals(
+        offset,
+        shadow_element(state, slots.vertex_buffers_offsets, index)?,
+    )?;
+    let same_format = shadow_equals(
+        format,
+        shadow_element(state, slots.vertex_buffers_formats, index)?,
+    )?;
+    if same_buffer && same_offset && same_format {
+        return Some(Value::Undefined);
+    }
+    None
+}
+
 /// Ключ кэша — таблица методов класса `Object3D`, а не экземпляра: метод вызывают на наследниках,
 /// и ключ по экземпляру вымывал бы кэш на каждом чередовании классов. Номера унаследованных слотов
 /// у всех наследников общие, потому что таблица наследника продолжает таблицу предка.
