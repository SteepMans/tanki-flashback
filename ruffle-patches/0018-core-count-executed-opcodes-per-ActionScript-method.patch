diff --git a/core/src/avm2/method_stats.rs b/core/src/avm2/method_stats.rs
new file mode 100644
index 00000000..1d32a404
--- /dev/null
+++ b/core/src/avm2/method_stats.rs
@@ -0,0 +1,150 @@
+//! Учёт выполненных инструкций по методам ActionScript.
+//!
+//! Профилировщик браузера видит внутри WASM только цикл интерпретатора (`run_actions`), поэтому по
+//! нему нельзя понять, КАКОЙ код игры съедает кадр. Здесь считается, сколько инструкций выполнено
+//! в каждом методе — собственных, без вложенных вызовов: у каждого вызова свой счётчик, дочерние
+//! вызовы копят в своих. Это прямой аналог self-time и достаточно точен, чтобы найти горячий код.
+//!
+//! Включается со страницы: `window.ruffleTraceMethods = true` (раз в секунду в лог уходит верхушка
+//! списка). Пока выключено, вся цена — один инкремент счётчика на инструкцию.
+
+use std::cell::{Cell, RefCell};
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use crate::avm2::method::Method;
+
+static ENABLED: AtomicBool = AtomicBool::new(false);
+/// Гистограмма по видам инструкций включается ОТДЕЛЬНО (window.ruffleTraceOps): счёт на каждой
+/// инструкции сам по себе заметно замедляет игру и смазал бы замер горячих методов.
+static OPS_ENABLED: AtomicBool = AtomicBool::new(false);
+
+thread_local! {
+    /// Имя метода -> (инструкций, вызовов).
+    static TOTALS: RefCell<HashMap<String, (u64, u64)>> = RefCell::new(HashMap::new());
+    /// Счётчики по видам инструкций. Массив ячеек, а не словарь: считаем на КАЖДОЙ инструкции,
+    /// и словарь со строковым ключом обходился в разы дороже самого интерпретатора.
+    static OPS: [Cell<u64>; OP_KINDS.len()] = const { [const { Cell::new(0) }; OP_KINDS.len()] };
+}
+
+pub fn set_enabled(value: bool) {
+    let was = ENABLED.swap(value, Ordering::Relaxed);
+    if was && !value {
+        TOTALS.with(|totals| totals.borrow_mut().clear());
+    }
+}
+
+pub fn enabled() -> bool {
+    ENABLED.load(Ordering::Relaxed)
+}
+
+pub fn set_ops_enabled(value: bool) {
+    OPS_ENABLED.store(value, Ordering::Relaxed);
+}
+
+pub fn ops_enabled() -> bool {
+    OPS_ENABLED.load(Ordering::Relaxed)
+}
+
+/// Имя вида `Класс/метод` — по нему код игры узнаётся даже после обфускации.
+fn label(method: Method<'_>) -> String {
+    let name = method
+        .method_name()
+        .map(|name| name.to_string())
+        .unwrap_or_else(|| format!("метод#{}", method.abc_method_index()));
+
+    match method.bound_class() {
+        Some(class) => format!("{}/{}", class.name().local_name(), name),
+        None => name,
+    }
+}
+
+pub fn record(method: Method<'_>, ops: u64) {
+    TOTALS.with(|totals| {
+        let mut totals = totals.borrow_mut();
+        let entry = totals.entry(label(method)).or_insert((0, 0));
+        entry.0 += ops;
+        entry.1 += 1;
+    });
+}
+
+/// Виды инструкций для гистограммы. Отдельно выделены обращения к полям: у Ruffle их несколько
+/// видов, и по соотношению видно, справился ли анализатор — Slot дешёвый, Slow ищет имя в таблице.
+pub const OP_KINDS: [&str; 16] = [
+    "GetSlot", "SetSlot", "GetPropertyStatic", "GetPropertyFast", "GetPropertySlow",
+    "SetProperty", "CallMethod", "CallNative", "CallProperty", "Construct",
+    "Local", "Arithmetic/Compare", "Branch", "Coerce", "Stack/Scope", "прочее",
+];
+
+/// Номер вида инструкции в `OP_KINDS`.
+pub fn op_kind(op: &crate::avm2::op::Op<'_>) -> usize {
+    use crate::avm2::op::Op;
+    match op {
+        Op::GetSlot { .. } => 0,
+        Op::SetSlot { .. } | Op::SetSlotNoCoerce { .. } | Op::SetSlotCoerceI { .. } => 1,
+        Op::GetPropertyStatic { .. } => 2,
+        Op::GetPropertyFast { .. } => 3,
+        Op::GetPropertySlow { .. } => 4,
+        Op::SetPropertyStatic { .. } | Op::SetPropertyFast { .. } | Op::SetPropertySlow { .. }
+        | Op::InitProperty { .. } => 5,
+        Op::CallMethod { .. } => 6,
+        Op::CallNative { .. } => 7,
+        Op::CallProperty { .. } | Op::CallPropVoid { .. } | Op::CallPropLex { .. }
+        | Op::Call { .. } | Op::CallStatic { .. } | Op::CallSuper { .. } => 8,
+        Op::Construct { .. } | Op::ConstructProp { .. } | Op::ConstructSlot { .. }
+        | Op::ConstructSuper { .. } => 9,
+        Op::GetLocal { .. } | Op::SetLocal { .. } | Op::StoreLocal { .. } | Op::Kill { .. } => 10,
+        Op::Add { .. } | Op::AddI | Op::Subtract { .. } | Op::SubtractI | Op::Multiply
+        | Op::MultiplyI | Op::Divide | Op::Modulo | Op::Negate | Op::NegateI
+        | Op::Increment | Op::IncrementI | Op::Decrement | Op::DecrementI
+        | Op::Equals | Op::StrictEquals | Op::LessThan | Op::LessEquals
+        | Op::GreaterThan | Op::GreaterEquals | Op::Not => 11,
+        Op::IfTrue { .. } | Op::IfFalse { .. } | Op::Jump { .. } | Op::PopJump { .. }
+        | Op::LookupSwitch(..) => 12,
+        Op::Coerce { .. } | Op::CoerceA | Op::CoerceB | Op::CoerceD | Op::CoerceI
+        | Op::CoerceO | Op::CoerceS | Op::CoerceU | Op::CoerceSwapPop { .. }
+        | Op::CoerceDSwapPop | Op::CoerceISwapPop | Op::CoerceUSwapPop => 13,
+        Op::PushDouble { .. } | Op::PushInt { .. } | Op::PushUint { .. } | Op::PushTrue
+        | Op::PushFalse | Op::PushNull | Op::PushUndefined | Op::PushString { .. }
+        | Op::Dup | Op::Pop | Op::Swap | Op::FindProperty { .. } | Op::FindPropStrict { .. }
+        | Op::FindDef { .. } | Op::GetScopeObject { .. } | Op::GetOuterScope { .. }
+        | Op::GetScriptGlobals { .. } | Op::PushScope { .. } | Op::PopScope => 14,
+        _ => 15,
+    }
+}
+
+/// Учитывает выполненную инструкцию. Вызывается только при включённом счётчике.
+pub fn record_op(kind: usize) {
+    OPS.with(|ops| {
+        let cell = &ops[kind];
+        cell.set(cell.get() + 1);
+    });
+}
+
+/// Гистограмма по видам инструкций; счётчики обнуляются.
+pub fn take_ops() -> Vec<(&'static str, u64)> {
+    OPS.with(|ops| {
+        let mut rows: Vec<_> = OP_KINDS
+            .iter()
+            .zip(ops.iter())
+            .map(|(name, cell)| (*name, cell.replace(0)))
+            .filter(|(_, count)| *count > 0)
+            .collect();
+        rows.sort_by(|a, b| b.1.cmp(&a.1));
+        rows
+    })
+}
+
+/// Верхушка списка по числу инструкций. Счётчики обнуляются, чтобы каждая выдача была за период.
+pub fn take_top(limit: usize) -> Vec<(String, u64, u64)> {
+    TOTALS.with(|totals| {
+        let mut totals = totals.borrow_mut();
+        let mut rows: Vec<_> = totals
+            .drain()
+            .map(|(name, (ops, calls))| (name, ops, calls))
+            .collect();
+        rows.sort_by(|a, b| b.1.cmp(&a.1));
+        rows.truncate(limit);
+        rows
+    })
+}
