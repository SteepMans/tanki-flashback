@@ -1488,3 +1495,28 @@ fn global_init() {
 
     tracing::info!("Ruffle WASM module has been initialized");
 }
+
+/// Читает булев флаг со страницы.
+fn flag_requested(window: &Window, name: &str) -> bool {
+    js_sys::Reflect::get(window, &JsValue::from_str(name))
+        .ok()
+        .and_then(|value| value.as_bool())
+        .unwrap_or(false)
+}
+
+/// Читает `window.ruffleTraceMethods` — печатать ли раз в секунду самые горячие методы игры.
+fn trace_methods_requested(window: &Window) -> bool {
+    flag_requested(window, "ruffleTraceMethods")
+}
+
+/// Читает `window.ruffleRenderScale` — во сколько раз рисовать подробнее экрана.
+/// По умолчанию 1; значения ограничены разумными пределами, иначе легко упереться
+/// в ограничение видеокарты на размер текстуры.
+fn render_scale(window: &Window) -> f64 {
+    js_sys::Reflect::get(window, &JsValue::from_str("ruffleRenderScale"))
+        .ok()
+        .and_then(|value| value.as_f64())
+        .filter(|value| value.is_finite())
+        .map(|value| value.clamp(1.0, 3.0))
+        .unwrap_or(1.0)
+}
