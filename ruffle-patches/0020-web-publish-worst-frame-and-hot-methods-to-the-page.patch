From 0099a15072c3de4b204eed63e0b460e8b75159d5 Mon Sep 17 00:00:00 2001
From: Konstantin <38701987+SteepMans@users.noreply.github.com>
Date: Sun, 16 Aug 2026 19:35:58 +0300
Subject: [PATCH] web: publish worst frame time, hitch count and hot methods to
 the page

---
 core/src/player.rs | 34 ----------------------------------
 web/src/lib.rs     | 44 +++++++++++++++++++++++++++++++++++++++++---
 2 files changed, 41 insertions(+), 37 deletions(-)

diff --git a/core/src/player.rs b/core/src/player.rs
index c25706cf..d0858ae9 100644
--- a/core/src/player.rs
+++ b/core/src/player.rs
@@ -2387,40 +2387,6 @@ impl Player {
                 *g / elapsed,
             );
 
-            // window.ruffleTraceMethods = true — раз в секунду печатаем, какие методы игры
-            // выполнили больше всего инструкций. Иначе на что уходит кадр, видно только целиком.
-            if crate::avm2::method_stats::enabled() {
-                let (total_ops, total_calls) = crate::avm2::method_stats::take_total();
-                tracing::info!(
-                    "AVM2 throughput: {:.0} ops/s, {:.0} calls/s, {:.0} ops per ms of script time",
-                    total_ops as f32 / elapsed,
-                    total_calls as f32 / elapsed,
-                    if *s > 0.0 { total_ops as f32 / *s } else { 0.0 },
-                );
-                let rows = crate::avm2::method_stats::take_top(15);
-                let total: u64 = rows.iter().map(|(_, ops, _)| ops).sum();
-                tracing::info!("hot ActionScript methods, {total} ops/s in top {}:", rows.len());
-                for (name, ops, calls) in rows {
-                    tracing::info!(
-                        "  {:>9} ops/s  {:>7} calls/s  {name}",
-                        (ops as f32 / elapsed) as u64,
-                        (calls as f32 / elapsed) as u64
-                    );
-                }
-                let ops = crate::avm2::method_stats::take_ops();
-                let all: u64 = ops.iter().map(|(_, count)| count).sum();
-                tracing::info!("op mix, {all} counted:");
-                for (name, count) in ops {
-                    tracing::info!("  {:>5.1}%  {:>9}/s  {name}", 100.0 * count as f32 / all as f32,
-                                   (count as f32 / elapsed) as u64);
-                }
-                tracing::info!("op pairs:");
-                for (name, count) in crate::avm2::method_stats::take_pairs(12) {
-                    tracing::info!("  {:>5.1}%  {:>9}/s  {name}", 100.0 * count as f32 / all as f32,
-                                   (count as f32 / elapsed) as u64);
-                }
-            }
-
             *started = web_time::Instant::now();
             *calls = 0;
             *s = 0.0;
diff --git a/web/src/lib.rs b/web/src/lib.rs
index d44e3cde..1863e0b9 100644
--- a/web/src/lib.rs
+++ b/web/src/lib.rs
@@ -1127,12 +1127,21 @@ impl RuffleHandle {
         render_time: std::time::Duration,
         rendered: bool,
     ) {
+        // Кроме средних за секунду считаем ХУДШИЙ кадр и число кадров дольше 33 мс: провалы
+        // частоты видны только так, в среднем они растворяются.
         thread_local! {
-            static FRAME_STATS: std::cell::RefCell<(web_time::Instant, u32, u32, f32, f32)> =
-                std::cell::RefCell::new((web_time::Instant::now(), 0, 0, 0.0, 0.0));
+            static FRAME_STATS: std::cell::RefCell<(web_time::Instant, u32, u32, f32, f32, f32, u32)> =
+                std::cell::RefCell::new((web_time::Instant::now(), 0, 0, 0.0, 0.0, 0.0, 0));
         }
 
-        FRAME_STATS.with_borrow_mut(|(started, ticks, renders, tick_ms, render_ms)| {
+        FRAME_STATS.with_borrow_mut(|(started, ticks, renders, tick_ms, render_ms, worst_ms, slow_frames)| {
+            let frame_ms = (tick_time + render_time).as_secs_f32() * 1000.0;
+            if frame_ms > *worst_ms {
+                *worst_ms = frame_ms;
+            }
+            if frame_ms > 33.0 {
+                *slow_frames += 1;
+            }
             *ticks += 1;
             *renders += u32::from(rendered);
             *tick_ms += tick_time.as_secs_f32() * 1000.0;
@@ -1154,11 +1163,38 @@ impl RuffleHandle {
                     }
                 };
 
+                // Список самых горячих методов игры — для профилировщика поверх игры.
+                if ruffle_core::method_stats::enabled() {
+                    let (total_ops, total_calls) = ruffle_core::method_stats::take_total();
+                    let rows = ruffle_core::method_stats::take_top(10);
+                    let list = js_sys::Array::new();
+                    for (name, ops, calls) in rows {
+                        let row = js_sys::Array::new();
+                        row.push(&JsValue::from_str(&name));
+                        row.push(&JsValue::from_f64(ops as f64 / elapsed as f64));
+                        row.push(&JsValue::from_f64(calls as f64 / elapsed as f64));
+                        list.push(&row);
+                    }
+                    let _ = js_sys::Reflect::set(&stats, &JsValue::from_str("hotMethods"), &list);
+                    let _ = js_sys::Reflect::set(
+                        &stats,
+                        &JsValue::from_str("opsPerSecond"),
+                        &JsValue::from_f64(total_ops as f64 / elapsed as f64),
+                    );
+                    let _ = js_sys::Reflect::set(
+                        &stats,
+                        &JsValue::from_str("callsPerSecond"),
+                        &JsValue::from_f64(total_calls as f64 / elapsed as f64),
+                    );
+                }
+
                 for (name, value) in [
                     ("ticks", *ticks as f64 / elapsed as f64),
                     ("renders", *renders as f64 / elapsed as f64),
                     ("asMs", (*tick_ms / *ticks as f32) as f64),
                     ("renderMs", (*render_ms / *ticks as f32) as f64),
+                    ("worstMs", *worst_ms as f64),
+                    ("slowFrames", *slow_frames as f64),
                 ] {
                     let _ = js_sys::Reflect::set(
                         &stats,
@@ -1181,6 +1217,8 @@ impl RuffleHandle {
             *renders = 0;
             *tick_ms = 0.0;
             *render_ms = 0.0;
+            *worst_ms = 0.0;
+            *slow_frames = 0;
         });
     }
 
-- 
2.51.1.windows.1

