+/// Поля `alternativa.gfx.core.Device`, через который движок грузит константы шейдера.
+mod device_fields {
+    /// `RenderState` с теневыми наборами констант.
+    pub const RENDER_STATE: &str = "e1e28469";
+    /// `Stage3D`, у которого спрашивают текущий `Context3D`.
+    pub const STAGE3D: &str = "e1044b0a";
+}
+
+/// Номера слотов, нужных для загрузки констант шейдера.
+#[derive(Clone, Copy)]
+struct DeviceSlots {
+    render_state: usize,
+    stage3d: usize,
+    vertex_constants: usize,
+    fragment_constants: usize,
+}
+
+thread_local! {
+    static DEVICE_SLOTS: RefCell<Option<(u32, DeviceSlots)>> = const { RefCell::new(None) };
+    static DEVICE_HOPELESS: Cell<bool> = const { Cell::new(false) };
+}
+
+fn device_slots<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    this: Object<'gc>,
+) -> Option<DeviceSlots> {
+    let key = this.vtable().id();
+    if let Some((known, slots)) = DEVICE_SLOTS.with(|cache| *cache.borrow())
+        && known == key
+    {
+        return Some(slots);
+    }
+    if DEVICE_HOPELESS.with(|flag| flag.get()) {
+        return None;
+    }
+
+    match resolve_device_slots(activation, this) {
+        Ok(slots) => {
+            DEVICE_SLOTS.with(|cache| *cache.borrow_mut() = Some((key, slots)));
+            Some(slots)
+        }
+        Err(hopeless) => {
+            if hopeless {
+                DEVICE_HOPELESS.with(|flag| flag.set(true));
+            }
+            None
+        }
+    }
+}
+
+fn resolve_device_slots<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    this: Object<'gc>,
+) -> Result<DeviceSlots, bool> {
+    use device_fields::*;
+
+    let render_state = slot_by_local_name(this, RENDER_STATE).ok_or(true)?;
+    let stage3d = slot_by_local_name(this, STAGE3D).ok_or(true)?;
+    // Имена теневых наборов открытые, но искать их надо на живом `RenderState`.
+    let state = this.get_slot(render_state).as_object().ok_or(false)?;
+
+    Ok(DeviceSlots {
+        render_state,
+        stage3d,
+        vertex_constants: slot_of(activation, state, "vertexConstants", false).ok_or(true)?,
+        fragment_constants: slot_of(activation, state, "fragmentConstants", false).ok_or(true)?,
+    })
+}
+
+/// Разобранный вызов загрузки констант: всё, что нужно и счёту, и снимку для сверки.
+struct ConstantsCall<'gc> {
+    this: Object<'gc>,
+    data: Object<'gc>,
+    shadow: Object<'gc>,
+    program_type: ProgramType,
+    first_register: i32,
+    num_registers: i32,
+    check: bool,
+    /// Отрезок теневого набора, который вызов трогает.
+    base: usize,
+    count: usize,
+    slots: DeviceSlots,
+}
+
+/// Разбирает аргументы вызова и заранее проверяет всё, из-за чего байткод мог бы бросить ошибку.
+/// `None` — случай не покрыт: пусть считает интерпретатор, ничего ещё не тронуто.
+fn constants_call<'gc>(activation: &mut Activation<'_, 'gc>) -> Option<ConstantsCall<'gc>> {
+    let this = activation.local_register(0).as_object()?;
+    let program_type = match activation.local_register(1) {
+        Value::String(name) => name,
+        _ => return None,
+    };
+    let first_register = match activation.local_register(2) {
+        Value::Integer(value) => value,
+        _ => return None,
+    };
+    let data = activation.local_register(3).as_object()?;
+    let num_registers = match activation.local_register(4) {
+        Value::Integer(value) => value,
+        _ => return None,
+    };
+    let check = match activation.local_register(5) {
+        Value::Bool(value) => value,
+        _ => return None,
+    };
+
+    // Отрицательное число регистров, кроме -1, ниже пришлось бы приводить к беззнаковому, и оно
+    // превратилось бы в огромную длину. Такой вызов отдаём байткоду.
+    if num_registers < -1 {
+        return None;
+    }
+
+    let slots = device_slots(activation, this)?;
+    let state = this.get_slot(slots.render_state).as_object()?;
+    let program_type = if &*program_type == b"vertex" {
+        ProgramType::Vertex
+    } else {
+        ProgramType::Fragment
+    };
+    let shadow = state
+        .get_slot(match program_type {
+            ProgramType::Vertex => slots.vertex_constants,
+            ProgramType::Fragment => slots.fragment_constants,
+        })
+        .as_object()?;
+    // Читать и писать один и тот же вектор одновременно нельзя: это двойное заимствование.
+    if Object::ptr_eq(data, shadow) {
+        return None;
+    }
+
+    let data_length = data.as_vector_storage()?.length();
+    let shadow_length = shadow.as_vector_storage()?.length();
+
+    let base = first_register.wrapping_shl(2);
+    let count = if num_registers < 0 {
+        data_length as i32
+    } else {
+        num_registers.wrapping_shl(2)
+    };
+    if base < 0 || count < 0 {
+        return None;
+    }
+    let (base, count) = (base as usize, count as usize);
+    // Выход за границы любого из векторов байткод превращает в RangeError. Такой вызов должен
+    // бросать ошибку сам, поэтому уступаем ему до того, как что-либо записали.
+    if count > data_length || base.saturating_add(count) > shadow_length {
+        return None;
+    }
+
+    Some(ConstantsCall {
+        this,
+        data,
+        shadow,
+        program_type,
+        first_register,
+        num_registers,
+        check,
+        base,
+        count,
+        slots,
+    })
+}
+
+/// `Device.setProgramConstantsFromVector` — движок держит теневую копию констант шейдера и грузит
+/// их в Stage3D, только если что-то поменялось. Сравнение идёт поэлементно, в байткоде это около
+/// двадцати инструкций на каждое число, а вызовов в бою двадцать восемь тысяч в секунду — на
+/// машине владельца метод занимал от 8 до 14 процентов кадра.
+///
+/// Здесь тот же цикл выполняется нативно, и загрузка констант, если она нужна, зовётся напрямую —
+/// минуя разбор аргументов нативного метода AVM2 и создание кадра вызова.
+fn set_program_constants<'gc>(activation: &mut Activation<'_, 'gc>) -> Option<Value<'gc>> {
+    let call = constants_call(activation)?;
+    let mc = activation.gc();
+
+    // Ветка без сверки просто переписывает теневой набор и грузит константы всегда.
+    let mut changed = !call.check;
+    {
+        let data = call.data.as_vector_storage()?;
+        let mut shadow = call.shadow.as_vector_storage_mut(mc)?;
+        for at in 0..call.count {
+            let value = data.get_optional(at)?.try_as_f64()?;
+            if call.check {
+                // `ifeq` в байткоде — обычное равенство чисел: NaN не равен себе, а минус ноль
+                // равен нулю, и на обоих отличиях держится решение «грузить или нет».
+                let old = shadow.get_optional(call.base + at)?.try_as_f64()?;
+                if old == value {
+                    continue;
+                }
+                changed = true;
+            }
+            shadow.set_in_range(call.base + at, Value::Number(value));
+        }
+    }
+
+    if changed
+        && let Some(stage3d) = call.this.get_slot(call.slots.stage3d).as_object()
+        && let Some(stage3d) = stage3d.as_stage_3d()
+        && let Some(context) = stage3d.context3d()
+    {
+        let data = call.data.as_vector_storage()?;
+        // Ровно тот же отбор, что и в `Context3D.setProgramConstantsFromVector`.
+        let to_take = if call.num_registers != -1 {
+            let required = call.num_registers as usize * 4;
+            if data.length() < required {
+                return None;
+            }
+            required
+        } else {
+            data.length()
+        };
+        let raw_data = data
+            .iter()
+            .map(|value| (value.as_f64() as f32).to_le_bytes())
+            .take(to_take)
+            .collect::<SmallVec<[[u8; 4]; 64]>>();
+        context.set_program_constants(call.program_type, call.first_register as u32, &raw_data);
+    }
+
+    Some(Value::Undefined)
+}
+
 /// Снимок полей, которые метод перезаписывает. Нужен режиму сверки: метод ничего не возвращает,
 /// поэтому сравнить нативный счёт с байткодом можно только по записанному — а чтобы байткод считал
