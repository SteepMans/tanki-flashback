+                last_wrapper = next;
+            }
+            let mut prev = link(last_wrapper, slots.wrapper_vertex)?; // l37
+            let mut prev_d = conflict_num(prev, slots.vertex_offset); // l24
+
+            let interpolate_normals = match face.get_slot(slots.face_material).as_object() {
+                Some(material) => match slots.material_use_normals {
+                    Some(slot) => material.get_slot(slot) == Value::Bool(true),
+                    None => return None,
+                },
+                None => false,
+            }; // l15
+
+            let mut walker = link(face, slots.face_wrapper); // l48
+            while let Some(current_wrapper) = walker {
+                let vertex = link(current_wrapper, slots.wrapper_vertex)?; // l38
+                let d = conflict_num(vertex, slots.vertex_offset); // l16
+                if (prev_d < behind_limit && d > front_limit)
+                    || (prev_d > front_limit && d < behind_limit)
+                {
+                    let t = (offset - prev_d) / (d - prev_d); // l46
+                    let created =
+                        conflict_new_vertex(activation, ctx, prev, vertex, t, interpolate_normals)?;
+                    negative_tail = Some(conflict_add_wrapper(
+                        activation, ctx, negative, negative_tail, created,
+                    )?);
+                    positive_tail = Some(conflict_add_wrapper(
+                        activation, ctx, positive, positive_tail, created,
+                    )?);
+                }
+                if d <= front_limit {
+                    negative_tail = Some(conflict_add_wrapper(
+                        activation, ctx, negative, negative_tail, vertex,
+                    )?);
+                }
+                if d >= behind_limit {
+                    positive_tail = Some(conflict_add_wrapper(
+                        activation, ctx, positive, positive_tail, vertex,
+                    )?);
+                }
+                prev = vertex;
+                prev_d = d;
+                walker = link(current_wrapper, slots.wrapper_next);
+            }
