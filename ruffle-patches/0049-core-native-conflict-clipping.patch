+            let mc = activation.gc();
+            match behind_tail {
+                Some(tail) => tail.set_slot_no_coerce(
+                    slots.face_process_next,
+                    Value::Object(negative),
+                    mc,
+                ),
+                None => behind_head = Some(negative),
+            }
+            behind_tail = Some(negative);
+            match front_tail {
+                Some(tail) => tail.set_slot_no_coerce(
+                    slots.face_process_next,
+                    Value::Object(positive),
+                    mc,
+                ),
+                None => front_head = Some(positive),
+            }
+            front_tail = Some(positive);
+            face.set_slot_no_coerce(slots.face_process_next, Value::Null, mc);
+            face.set_slot_no_coerce(slots.face_geometry, Value::Null, mc);
+        }
