+    // Дальняя сторона.
+    if let Some(subtree) = far {
+        subtree.set_slot_no_coerce(slots.face_geometry, geometry_value, mc);
+        if let Some(tail) = front_tail {
+            tail.set_slot_no_coerce(slots.face_process_next, Value::Null, mc);
+        }
+        result = conflict_clip_node(activation, ctx, Some(subtree), front_head, result, depth + 1)?;
