+/// Раскрой списка граней деревом разделителей: дословный перенос `e48c6fdc`. Возвращает голову
+/// собранной задом наперёд выходной цепочки (аргумент-аккумулятор `result`).
+fn conflict_clip_node<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    ctx: &ConflictCtx<'gc>,
+    splitter_in: Option<Object<'gc>>,   // l1
+    list: Option<Object<'gc>>,          // l2
+    result_in: Value<'gc>,              // l6
+    depth: u32,
+) -> Option<Value<'gc>> {
+    if depth > 2048 {
+        return None;
+    }
+    let slots = &ctx.slots;
+    let mc = activation.gc();
+    let link = |object: Object<'gc>, slot: usize| object.get_slot(slot).as_object();
+
+    let mut splitter = splitter_in; // l1
+    let mut list = list; // l2
+    let mut result = result_in; // l6
+
+    // Плоскость и поддеревья.
+    let mut geometry_value = Value::Null; // l52
+    let mut near = None; // l28 — ближнее поддерево (обрабатывается вторым)
+    let mut far = None; // l40 — дальнее (обрабатывается первым)
+    let (mut nx, mut ny, mut nz, mut offset); // l7, l10, l11, l21
+    let mut chain_tail = None; // l44 — хвост цепочки «на плоскости»
+
+    if let Some(plane) = splitter {
+        geometry_value = plane.get_slot(slots.face_geometry);
+        // Ветвление повторяет `ifnlt` байткода: при offset < 0 плоскость берётся как есть,
+        // иначе (включая NaN) нормаль и смещение переворачиваются, а поддеревья меняются
+        // местами — так ближняя сторона всегда оказывается ближней к камере.
+        if conflict_num(plane, slots.face_offset) < 0.0 {
+            near = link(plane, slots.face_process_negative);
+            far = link(plane, slots.face_process_positive);
+            nx = conflict_num(plane, slots.face_normal[0]);
+            ny = conflict_num(plane, slots.face_normal[1]);
+            nz = conflict_num(plane, slots.face_normal[2]);
+            offset = conflict_num(plane, slots.face_offset);
+        } else {
+            near = link(plane, slots.face_process_positive);
+            far = link(plane, slots.face_process_negative);
+            nx = -conflict_num(plane, slots.face_normal[0]);
+            ny = -conflict_num(plane, slots.face_normal[1]);
+            nz = -conflict_num(plane, slots.face_normal[2]);
+            offset = -conflict_num(plane, slots.face_offset);
+        }
+        plane.set_slot_no_coerce(slots.face_process_negative, Value::Null, mc);
+        plane.set_slot_no_coerce(slots.face_process_positive, Value::Null, mc);
+        if link(plane, slots.face_wrapper).is_some() {
+            // Разделитель — живая цепочка граней: пометить геометрию у хвостов.
+            let mut walker = plane;
+            while let Some(next) = link(walker, slots.face_process_next) {
+                walker = next;
+                walker.set_slot_no_coerce(slots.face_geometry, geometry_value, mc);
+            }
+            chain_tail = Some(walker);
+        } else {
+            plane.set_slot_no_coerce(slots.face_geometry, Value::Null, mc);
+            splitter = None;
+        }
+    } else {
+        // Разделителя нет: плоскость строится по первой грани списка.
+        let plane = list?;
+        list = link(plane, slots.face_process_next);
+        splitter = Some(plane);
+        chain_tail = Some(plane);
+
+        let mut wrapper = link(plane, slots.face_wrapper)?; // l48
+        let a = link(wrapper, slots.wrapper_vertex)?; // l37
+        wrapper = link(wrapper, slots.wrapper_next)?;
+        let b = link(wrapper, slots.wrapper_vertex)?; // l38
+        let ax = conflict_num(a, slots.vertex_camera[0]); // l32
+        let ay = conflict_num(a, slots.vertex_camera[1]); // l8
+        let az = conflict_num(a, slots.vertex_camera[2]); // l17
+        let abx = conflict_num(b, slots.vertex_camera[0]) - ax; // l22
+        let aby = conflict_num(b, slots.vertex_camera[1]) - ay; // l54
+        let abz = conflict_num(b, slots.vertex_camera[2]) - az; // l34
+        nx = 0.0;
+        ny = 0.0;
+        nz = 1.0;
+        offset = az;
+        let mut best = 0.0f64; // l41
+        let mut walker = link(wrapper, slots.wrapper_next);
+        while let Some(current) = walker {
+            let c = link(current, slots.wrapper_vertex)?; // l47
+            let acx = conflict_num(c, slots.vertex_camera[0]) - ax; // l51
+            let acy = conflict_num(c, slots.vertex_camera[1]) - ay; // l20
+            let acz = conflict_num(c, slots.vertex_camera[2]) - az; // l9
+            let cx = acz * aby - acy * abz; // l35
+            let cy = acx * abz - acz * abx; // l13
+            let cz = acy * abx - acx * aby; // l14
+            let len2 = cx * cx + cy * cy + cz * cz; // l27
+            if len2 > ctx.threshold {
+                let k = 1.0 / len2.sqrt();
+                nx = cx * k;
+                ny = cy * k;
+                nz = cz * k;
+                offset = ax * nx + ay * ny + az * nz;
+                break;
+            } else if len2 > best {
+                let k = 1.0 / len2.sqrt();
+                nx = cx * k;
+                ny = cy * k;
+                nz = cz * k;
+                offset = ax * nx + ay * ny + az * nz;
+                best = len2;
+            }
+            walker = link(current, slots.wrapper_next);
+        }
+    }
+
+    let behind_limit = offset - ctx.threshold; // l19
+    let front_limit = offset + ctx.threshold; // l36
+
+    // Списки по сторонам плоскости.
+    let mut front_head: Option<Object<'gc>> = None; // l12
+    let mut front_tail: Option<Object<'gc>> = None; // l26
+    let mut behind_head: Option<Object<'gc>> = None; // l23
+    let mut behind_tail: Option<Object<'gc>> = None; // l49
+
+    let mut current = list; // l45
+    while let Some(face) = current {
+        let after = link(face, slots.face_process_next); // l25
+
+        let mut wrapper = link(face, slots.face_wrapper)?; // l48
+        let v1 = link(wrapper, slots.wrapper_vertex)?; // l37
+        wrapper = link(wrapper, slots.wrapper_next)?;
+        let v2 = link(wrapper, slots.wrapper_vertex)?; // l38
+        wrapper = link(wrapper, slots.wrapper_next)?;
+        let v3 = link(wrapper, slots.wrapper_vertex)?; // l39
+        let mut rest = link(wrapper, slots.wrapper_next); // l48
+
+        let dot = |vertex: Object<'gc>| {
+            conflict_num(vertex, slots.vertex_camera[0]) * nx
+                + conflict_num(vertex, slots.vertex_camera[1]) * ny
+                + conflict_num(vertex, slots.vertex_camera[2]) * nz
+        };
+        let d1 = dot(v1); // l24
+        let d2 = dot(v2); // l16
+        let d3 = dot(v3); // l30
+        let mut is_behind = d1 < behind_limit || d2 < behind_limit || d3 < behind_limit; // l42
+        let mut is_front = d1 > front_limit || d2 > front_limit || d3 > front_limit; // l29
+        while let Some(extra) = rest {
+            let vertex = link(extra, slots.wrapper_vertex)?; // l47
+            let d = dot(vertex); // l50
+            if d < behind_limit {
+                is_behind = true;
+            } else if d > front_limit {
+                is_front = true;
+            }
+            set(vertex, slots.vertex_offset, d, mc);
+            rest = link(extra, slots.wrapper_next);
+        }
+
+        if !is_behind {
+            if !is_front {
+                // В пределах порога: в цепочку разделителя.
+                match chain_tail {
+                    Some(tail) if splitter.is_some() => {
+                        tail.set_slot_no_coerce(
+                            slots.face_process_next,
+                            Value::Object(face),
+                            mc,
+                        );
+                    }
+                    _ => splitter = Some(face),
+                }
+                chain_tail = Some(face);
+            } else {
+                match front_tail {
+                    Some(tail) => tail.set_slot_no_coerce(
+                        slots.face_process_next,
+                        Value::Object(face),
+                        mc,
+                    ),
+                    None => front_head = Some(face),
+                }
+                front_tail = Some(face);
+            }
+        } else if !is_front {
+            match behind_tail {
+                Some(tail) => {
+                    tail.set_slot_no_coerce(slots.face_process_next, Value::Object(face), mc)
+                }
+                None => behind_head = Some(face),
+            }
+            behind_tail = Some(face);
+        } else {
+            // Пересекает слой: резка на два полигона.
+            set(v1, slots.vertex_offset, d1, mc);
+            set(v2, slots.vertex_offset, d2, mc);
+            set(v3, slots.vertex_offset, d3, mc);
+            let negative = conflict_new_face(activation, ctx, face)?; // l33
+            let positive = conflict_new_face(activation, ctx, face)?; // l43
+            let mut negative_tail: Option<Object<'gc>> = None; // l18
+            let mut positive_tail: Option<Object<'gc>> = None; // l31
+
+            // Последняя вершина замыкает контур с первой.
+            let mut last_wrapper = link(link(link(face, slots.face_wrapper)?, slots.wrapper_next)?, slots.wrapper_next)?;
