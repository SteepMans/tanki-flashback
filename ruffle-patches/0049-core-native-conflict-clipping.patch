+    // Грани «на плоскости» вместе с разделителем.
+    if let Some(plane) = splitter {
+        chain_tail?.set_slot_no_coerce(slots.face_process_next, result, mc);
+        result = Value::Object(plane);
+    }
+
+    // Ближняя сторона.
+    if let Some(subtree) = near {
+        subtree.set_slot_no_coerce(slots.face_geometry, geometry_value, mc);
+        if let Some(tail) = behind_tail {
+            tail.set_slot_no_coerce(slots.face_process_next, Value::Null, mc);
+        }
+        result = conflict_clip_node(activation, ctx, Some(subtree), behind_head, result, depth + 1)?;
+    } else if let Some(head) = behind_head {
+        let tail = behind_tail?;
+        if ctx.sort_flag && !Object::ptr_eq(head, tail) {
+            tail.set_slot_no_coerce(slots.face_process_next, Value::Null, mc);
+            let geometry = link(head, slots.face_geometry)?;
+            let sorting_slot = slots.vg_sorting?;
+            if geometry.get_slot(sorting_slot) == Value::Integer(2) {
+                result = conflict_clip_node(activation, ctx, None, Some(head), result, depth + 1)?;
+            } else {
+                let sorted = sort_by_average_z(activation, slots, head)?;
+                let mc = activation.gc();
+                let mut walker = sorted;
+                while let Some(next) = link(walker, slots.face_process_next) {
+                    walker = next;
+                }
+                walker.set_slot_no_coerce(slots.face_process_next, result, mc);
+                result = Value::Object(sorted);
+            }
+        } else {
+            tail.set_slot_no_coerce(slots.face_process_next, result, mc);
+            result = Value::Object(head);
+        }
+    }
+
+    Some(result)
+}
