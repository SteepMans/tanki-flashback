+/// Соберёт контекст резки и проверит вход; `None` — до первой записи, уступая интерпретатору.
+fn conflict_context<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+) -> Option<(ConflictCtx<'gc>, ConflictScan<'gc>, Option<Object<'gc>>, Option<Object<'gc>>)> {
+    let splitter = activation.local_register(1).as_object();
+    let list = activation.local_register(2).as_object();
+    let camera = activation.local_register(3).as_object()?;
+    let threshold = activation.local_register(4).try_as_f64()?;
+    let sort_flag = match activation.local_register(5) {
+        Value::Bool(value) => value,
+        _ => return None,
+    };
+
+    // Слоты разбираются по любой живой грани вызова.
+    let sample = splitter.or(list)?;
+    let mut slots = conflict_slots(activation, sample, camera)?;
+    if camera.vtable().id() != slots.camera_vtable {
+        return None;
+    }
+    let scan = conflict_prescan(activation, &mut slots, splitter, list)?;
+    // Дорезолвленные ленивые слоты — обратно в кэш.
+    CONFLICT_SLOTS.with(|cache| *cache.borrow_mut() = Some(slots));
+
+    // Учётные цепочки кадра должны быть непустыми: байткод пишет lastFace.next без проверки,
+    // и пустой хвост означал бы, что вызов пришёл не из отрисовки.
+    camera.get_slot(slots.camera_last_face).as_object()?;
+    camera.get_slot(slots.camera_last_vertex).as_object()?;
+
+    // Классы пулов — от живых объектов.
+    let face_class: Object<'gc> = sample.instance_class().class_object()?.into();
+    let first_wrapper = scan
+        .list_faces
+        .first()
+        .copied()
+        .or(scan.splitter_faces.iter().copied().find(|face| {
+            face.get_slot(slots.face_wrapper).as_object().is_some()
+        }))
+        .and_then(|face| face.get_slot(slots.face_wrapper).as_object());
+    let wrapper_class: Object<'gc> = first_wrapper?.instance_class().class_object()?.into();
+    let vertex_class: Object<'gc> = scan
+        .vertices
+        .first()?
+        .instance_class()
+        .class_object()?
+        .into();
+
+    Some((
+        ConflictCtx {
+            slots,
+            camera,
+            face_class,
+            wrapper_class,
+            vertex_class,
+            threshold,
+            sort_flag,
+        },
+        scan,
+        splitter,
+        list,
+    ))
+}
+
+/// Длина списка свободных у класса. Нужна сверке: если пул может исчерпаться, нативный счёт и
+/// байткод создали бы РАЗНЫЕ объекты, и сравнение адресов стало бы ложной тревогой.
+fn conflict_pool_len<'gc>(
+    class_as_object: Object<'gc>,
+    collector_slot: usize,
+    next_slot: usize,
+) -> usize {
+    let mut count = 0usize;
+    let mut node = class_as_object.get_slot(collector_slot).as_object();
+    while let Some(current) = node {
+        count += 1;
+        if count >= 262_144 {
+            break;
+        }
+        node = current.get_slot(next_slot).as_object();
+    }
+    count
+}
+
+/// `ConflictContainer.e48c6fdc` — художническая сортировка конфликтной прозрачной геометрии:
+/// список граней раскраивается деревом разделителей, пересекающие слой грани режутся на два
+/// полигона вершинами из пулов, куски собираются в выходную цепочку от дальних к ближним.
+/// В тяжёлых кадрах у владельца это до четверти всего ActionScript.
+fn conflict_clip<'gc>(activation: &mut Activation<'_, 'gc>) -> Option<Value<'gc>> {
+    let (ctx, scan, splitter, list) = conflict_context(activation)?;
+
+    // В режиме сверки требуем запас в пулах: на исчерпании оба прохода строили бы новые объекты,
+    // и они бы не совпали адресами. Оценка сверху: два полигона и цепочка звеньев на грань.
+    if crate::method_stats::validate_native_paths() {
+        let faces_needed = scan.list_faces.len() * 2 + 8;
+        let wrappers_needed = scan.vertices.len() * 4 + 16;
+        let vertices_needed = scan.vertices.len() * 2 + 16;
+        if conflict_pool_len(ctx.face_class, ctx.slots.face_collector, ctx.slots.face_next)
+            < faces_needed
+            || conflict_pool_len(
+                ctx.wrapper_class,
+                ctx.slots.wrapper_collector,
+                ctx.slots.wrapper_next,
+            ) < wrappers_needed
+            || conflict_pool_len(
+                ctx.vertex_class,
+                ctx.slots.vertex_collector,
+                ctx.slots.vertex_next,
+            ) < vertices_needed
+        {
+            return None;
+        }
+    }
+
+    let result = activation.local_register(6);
+    conflict_clip_node(activation, &ctx, splitter, list, result, 0)
+}
+
+/// Вход `Camera3D.sortByAverageZ` как самостоятельной замены.
+fn sort_faces_entry<'gc>(activation: &mut Activation<'_, 'gc>) -> Option<Value<'gc>> {
+    let camera = activation.local_register(0).as_object()?;
+    let head = activation.local_register(1).as_object()?;
+    let slots = conflict_slots(activation, head, camera)?;
+
+    // Валидация цепи до первой записи: классы граней, звеньев и вершин.
+    let faces = conflict_chain(Some(head), &slots)?;
+    for face in faces.iter() {
+        let mut link = face.get_slot(slots.face_wrapper).as_object();
+        while let Some(wrapper) = link {
+            if wrapper.vtable().id() != slots.wrapper_vtable {
+                return None;
+            }
+            let vertex = wrapper.get_slot(slots.wrapper_vertex).as_object()?;
+            if vertex.vtable().id() != slots.vertex_vtable {
+                return None;
+            }
+            link = wrapper.get_slot(slots.wrapper_next).as_object();
+        }
+    }
+
+    sort_by_average_z(activation, &slots, head).map(Value::Object)
+}
