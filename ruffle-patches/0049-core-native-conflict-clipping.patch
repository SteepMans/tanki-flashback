+/// Номера слотов для резки конфликтной прозрачной геометрии (`ConflictContainer.e48c6fdc`)
+/// и сортировки по среднему Z (`Camera3D.sortByAverageZ`).
+#[derive(Clone, Copy)]
+struct ConflictSlots {
+    /// Грань: звено, цепочки, геометрия, плоскость, средняя глубина.
+    face_wrapper: usize,
+    face_process_next: usize,
+    face_process_negative: usize,
+    face_process_positive: usize,
+    face_next: usize,
+    face_geometry: usize,
+    face_normal: [usize; 3],
+    face_offset: usize,
+    face_distance: usize,
+    /// material — открытое имя.
+    face_material: usize,
+    /// Звено.
+    wrapper_vertex: usize,
+    wrapper_next: usize,
+    /// Вершина: камерные координаты, запомненное расстояние до плоскости, пул и текстурные
+    /// координаты с локальными полями для интерполяции.
+    vertex_camera: [usize; 3],
+    vertex_offset: usize,
+    vertex_next: usize,
+    vertex_transform_id: usize,
+    vertex_draw_id: usize,
+    vertex_uv: [usize; 2],
+    vertex_local: [usize; 3],
+    vertex_normal: [usize; 3],
+    /// useVerticesNormals на базовом классе материала; None — материалов ещё не встречалось.
+    material_use_normals: Option<usize>,
+    /// sorting на VG; None — геометрий ещё не встречалось.
+    vg_sorting: Option<usize>,
+    /// Хвосты учётных цепочек кадра на камере.
+    camera_last_face: usize,
+    camera_last_vertex: usize,
+    /// Статические списки свободных на классах Face/Wrapper/Vertex.
+    face_collector: usize,
+    wrapper_collector: usize,
+    vertex_collector: usize,
+    /// Таблицы методов, на которых всё разобрано.
+    face_vtable: u32,
+    wrapper_vtable: u32,
+    vertex_vtable: u32,
+    camera_vtable: u32,
+}
+
+thread_local! {
+    static CONFLICT_SLOTS: RefCell<Option<ConflictSlots>> = const { RefCell::new(None) };
+    static CONFLICT_HOPELESS: Cell<bool> = const { Cell::new(false) };
+}
+
+/// Разбор слотов по живым объектам: грань со звеном и вершиной плюс камера.
+fn conflict_slots<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    face: Object<'gc>,
+    camera: Object<'gc>,
+) -> Option<ConflictSlots> {
+    if let Some(slots) = CONFLICT_SLOTS.with(|cache| *cache.borrow()) {
+        return Some(slots);
+    }
+    if CONFLICT_HOPELESS.with(|flag| flag.get()) {
+        return None;
+    }
+
+    let resolve = |activation: &mut Activation<'_, 'gc>| -> Result<ConflictSlots, bool> {
+        let engine = |activation: &mut Activation<'_, 'gc>, object, name| {
+            slot_of(activation, object, name, true).ok_or(true)
+        };
+        let public = |activation: &mut Activation<'_, 'gc>, object, name| {
+            slot_of(activation, object, name, false).ok_or(true)
+        };
+
+        let face_wrapper = engine(activation, face, "wrapper")?;
+        let wrapper = face
+            .get_slot(face_wrapper)
+            .as_object()
+            .ok_or(("звено ещё не заполнено", false).1)?;
+        let wrapper_vertex = engine(activation, wrapper, "vertex")?;
+        let vertex = wrapper
+            .get_slot(wrapper_vertex)
+            .as_object()
+            .ok_or(("вершина ещё не заполнена", false).1)?;
+
+        let face_class: Object<'gc> = face
+            .instance_class()
+            .class_object()
+            .ok_or(("класс грани недоступен", false).1)?
+            .into();
+        let wrapper_class: Object<'gc> = wrapper
+            .instance_class()
+            .class_object()
+            .ok_or(("класс звена недоступен", false).1)?
+            .into();
+        let vertex_class: Object<'gc> = vertex
+            .instance_class()
+            .class_object()
+            .ok_or(("класс вершины недоступен", false).1)?
+            .into();
+
+        Ok(ConflictSlots {
+            face_wrapper,
+            face_process_next: engine(activation, face, "processNext")?,
+            face_process_negative: engine(activation, face, "processNegative")?,
+            face_process_positive: engine(activation, face, "processPositive")?,
+            face_next: engine(activation, face, "next")?,
+            face_geometry: engine(activation, face, "geometry")?,
+            face_normal: [
+                engine(activation, face, "normalX")?,
+                engine(activation, face, "normalY")?,
+                engine(activation, face, "normalZ")?,
+            ],
+            face_offset: engine(activation, face, "offset")?,
+            face_distance: engine(activation, face, "distance")?,
+            face_material: public(activation, face, "material")?,
+            wrapper_vertex,
+            wrapper_next: engine(activation, wrapper, "next")?,
+            vertex_camera: [
+                engine(activation, vertex, "cameraX")?,
+                engine(activation, vertex, "cameraY")?,
+                engine(activation, vertex, "cameraZ")?,
+            ],
+            vertex_offset: engine(activation, vertex, "offset")?,
+            vertex_next: engine(activation, vertex, "next")?,
+            vertex_transform_id: engine(activation, vertex, "transformId")?,
+            vertex_draw_id: engine(activation, vertex, "drawId")?,
+            vertex_uv: [
+                public(activation, vertex, "u")?,
+                public(activation, vertex, "v")?,
+            ],
+            vertex_local: [
+                public(activation, vertex, "x")?,
+                public(activation, vertex, "y")?,
+                public(activation, vertex, "z")?,
+            ],
+            vertex_normal: [
+                public(activation, vertex, "normalX")?,
+                public(activation, vertex, "normalY")?,
+                public(activation, vertex, "normalZ")?,
+            ],
+            material_use_normals: None,
+            vg_sorting: None,
+            camera_last_face: engine(activation, camera, "lastFace")?,
+            camera_last_vertex: engine(activation, camera, "lastVertex")?,
+            face_collector: engine(activation, face_class, "collector")?,
+            wrapper_collector: engine(activation, wrapper_class, "collector")?,
+            vertex_collector: engine(activation, vertex_class, "collector")?,
+            face_vtable: face.vtable().id(),
+            wrapper_vtable: wrapper.vtable().id(),
+            vertex_vtable: vertex.vtable().id(),
+            camera_vtable: camera.vtable().id(),
+        })
+    };
+    match resolve(activation) {
+        Ok(slots) => {
+            CONFLICT_SLOTS.with(|cache| *cache.borrow_mut() = Some(slots));
+            Some(slots)
+        }
+        Err(hopeless) => {
+            if hopeless {
+                CONFLICT_HOPELESS.with(|flag| flag.set(true));
+            }
+            None
+        }
+    }
+}
+
+/// Всё, что нужно резке, собранное и проверенное до первой записи.
+struct ConflictCtx<'gc> {
+    slots: ConflictSlots,
+    camera: Object<'gc>,
+    face_class: Object<'gc>,
+    wrapper_class: Object<'gc>,
+    vertex_class: Object<'gc>,
+    /// Порог отделения «на плоскости» (аргумент threshold).
+    threshold: f64,
+    /// Сортировать ли подсписки без поддеревьев (аргумент l5).
+    sort_flag: bool,
+}
+
+/// Обход цепочки граней по processNext. `None` — чужой класс или цепь длиннее предела.
+fn conflict_chain<'gc>(
+    head: Option<Object<'gc>>,
+    slots: &ConflictSlots,
+) -> Option<Vec<Object<'gc>>> {
+    let mut out = Vec::new();
+    let mut node = head;
+    while let Some(face) = node {
+        if face.vtable().id() != slots.face_vtable || out.len() >= 4096 {
+            return None;
+        }
+        out.push(face);
+        node = face.get_slot(slots.face_process_next).as_object();
+    }
+    Some(out)
+}
+
+/// Итог прескана: грани и вершины, которые вызов может задеть.
+struct ConflictScan<'gc> {
+    /// Все узлы дерева разделителей (сам splitter, его цепочки и поддеревья).
+    splitter_faces: Vec<Object<'gc>>,
+    /// Все грани раскраиваемого списка (включая их будущие подсписки).
+    list_faces: Vec<Object<'gc>>,
+    /// Вершины граней списка.
+    vertices: Vec<Object<'gc>>,
+}
+
+/// Прескан: валидация классов и структуры до единственной записи. Заодно лениво дорезолвливает
+/// слоты материала и геометрии — они видны только на живых объектах.
+fn conflict_prescan<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    slots: &mut ConflictSlots,
+    splitter: Option<Object<'gc>>,
+    list: Option<Object<'gc>>,
+) -> Option<ConflictScan<'gc>> {
+    let mut scan = ConflictScan {
+        splitter_faces: Vec::new(),
+        list_faces: Vec::new(),
+        vertices: Vec::new(),
+    };
+
+    // Дерево разделителей: цепочки processNext и поддеревья processNegative/processPositive.
+    let mut stack: Vec<Object<'gc>> = Vec::new();
+    if let Some(splitter) = splitter {
+        stack.push(splitter);
+    }
+    while let Some(node) = stack.pop() {
+        let mut chain = Some(node);
+        while let Some(face) = chain {
+            if face.vtable().id() != slots.face_vtable || scan.splitter_faces.len() >= 4096 {
+                return None;
+            }
+            scan.splitter_faces.push(face);
+            for child_slot in [slots.face_process_negative, slots.face_process_positive] {
+                if let Some(child) = face.get_slot(child_slot).as_object() {
+                    if stack.len() >= 4096 {
+                        return None;
+                    }
+                    stack.push(child);
+                }
+            }
+            chain = face.get_slot(slots.face_process_next).as_object();
+        }
+    }
+
+    // Грани списка: у каждой минимум три звена (байткод читает третью вершину без проверки).
+    let list_faces = conflict_chain(list, slots)?;
+    for face in list_faces.iter() {
+        let mut count = 0usize;
+        let mut link = face.get_slot(slots.face_wrapper).as_object();
+        while let Some(wrapper) = link {
+            if wrapper.vtable().id() != slots.wrapper_vtable || scan.vertices.len() >= 65536 {
+                return None;
+            }
+            let vertex = wrapper.get_slot(slots.wrapper_vertex).as_object()?;
+            if vertex.vtable().id() != slots.vertex_vtable {
+                return None;
+            }
+            scan.vertices.push(vertex);
+            count += 1;
+            link = wrapper.get_slot(slots.wrapper_next).as_object();
+        }
+        if count < 3 {
+            return None;
+        }
+        // Ленивые слоты: материал и геометрия видны только здесь.
+        if slots.material_use_normals.is_none()
+            && let Some(material) = face.get_slot(slots.face_material).as_object()
+        {
+            slots.material_use_normals =
+                Some(slot_of(activation, material, "useVerticesNormals", true)?);
+        }
+        if slots.vg_sorting.is_none()
+            && let Some(geometry) = face.get_slot(slots.face_geometry).as_object()
+        {
+            slots.vg_sorting = Some(slot_of(activation, geometry, "sorting", true)?);
+        }
+    }
+    if slots.vg_sorting.is_none()
+        && let Some(splitter) = splitter
+        && let Some(geometry) = splitter.get_slot(slots.face_geometry).as_object()
+    {
+        slots.vg_sorting = Some(slot_of(activation, geometry, "sorting", true)?);
+    }
+    scan.list_faces = list_faces;
+    Some(scan)
+}
+
+/// Взять объект из списка свободных класса или, если пул пуст, построить новый конструктором.
+fn conflict_take<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    class_as_object: Object<'gc>,
+    collector_slot: usize,
+    next_slot: usize,
+    expected_vtable: u32,
+) -> Option<Object<'gc>> {
+    let mc = activation.gc();
+    if let Some(head) = class_as_object.get_slot(collector_slot).as_object()
+        && head.vtable().id() == expected_vtable
+    {
+        let next = head.get_slot(next_slot);
+        class_as_object.set_slot_no_coerce(collector_slot, next, mc);
+        head.set_slot_no_coerce(next_slot, Value::Null, mc);
+        return Some(head);
+    }
+    // Пул пуст: как и байткод, зовём настоящий конструктор (он у этих классов пустой).
+    let class_object = class_as_object.as_class_object()?;
+    class_object.construct(activation, &[]).ok()?.as_object()
+}
+
+/// Числовое поле; незаполненное читается как NaN — так его видит и байткод.
+fn conflict_num<'gc>(object: Object<'gc>, slot: usize) -> f64 {
+    object.get_slot(slot).try_as_f64().unwrap_or(f64::NAN)
+}
+
+/// Новая вершина резки: интерполяция камерных и текстурных координат, при необходимости —
+/// локальных координат и нормали. Порядок операций повторяет байткод дословно.
+#[allow(clippy::too_many_arguments)]
+fn conflict_new_vertex<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    ctx: &ConflictCtx<'gc>,
+    prev: Object<'gc>,
+    current: Object<'gc>,
+    t: f64,
+    interpolate_normals: bool,
+) -> Option<Object<'gc>> {
+    let slots = &ctx.slots;
+    let vertex = conflict_take(
+        activation,
+        ctx.vertex_class,
+        slots.vertex_collector,
+        slots.vertex_next,
+        slots.vertex_vtable,
+    )?;
+    let mc = activation.gc();
+    // Свежая вершина из пула: как в Vertex.create.
+    vertex.set_slot_no_coerce(slots.vertex_transform_id, Value::Integer(0), mc);
+    vertex.set_slot_no_coerce(slots.vertex_draw_id, Value::Integer(0), mc);
+    // Учёт кадра: camera.lastVertex.next = vertex; camera.lastVertex = vertex.
+    if let Some(last) = ctx.camera.get_slot(slots.camera_last_vertex).as_object() {
+        last.set_slot_no_coerce(slots.vertex_next, Value::Object(vertex), mc);
+    }
+    ctx.camera
+        .set_slot_no_coerce(slots.camera_last_vertex, Value::Object(vertex), mc);
+
+    let lerp = |slot: usize| {
+        let a = conflict_num(prev, slot);
+        let b = conflict_num(current, slot);
+        a + (b - a) * t
+    };
+    for slot in [
+        slots.vertex_camera[0],
+        slots.vertex_camera[1],
+        slots.vertex_camera[2],
+        slots.vertex_uv[0],
+        slots.vertex_uv[1],
+    ] {
+        set(vertex, slot, lerp(slot), mc);
+    }
+    if interpolate_normals {
+        for slot in [
+            slots.vertex_local[0],
+            slots.vertex_local[1],
+            slots.vertex_local[2],
+            slots.vertex_normal[0],
+            slots.vertex_normal[1],
+            slots.vertex_normal[2],
+        ] {
+            set(vertex, slot, lerp(slot), mc);
+        }
+    }
+    Some(vertex)
+}
+
+/// Приписать к полигону новое звено с данной вершиной. `tail` — прежний хвост (None — полигон
+/// ещё пуст, звено становится его первым, через face.wrapper).
+fn conflict_add_wrapper<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    ctx: &ConflictCtx<'gc>,
+    polygon: Object<'gc>,
+    tail: Option<Object<'gc>>,
+    vertex: Object<'gc>,
+) -> Option<Object<'gc>> {
+    let slots = &ctx.slots;
+    let wrapper = conflict_take(
+        activation,
+        ctx.wrapper_class,
+        slots.wrapper_collector,
+        slots.wrapper_next,
+        slots.wrapper_vtable,
+    )?;
+    let mc = activation.gc();
+    wrapper.set_slot_no_coerce(slots.wrapper_vertex, Value::Object(vertex), mc);
+    match tail {
+        Some(tail) => tail.set_slot_no_coerce(slots.wrapper_next, Value::Object(wrapper), mc),
+        None => polygon.set_slot_no_coerce(slots.face_wrapper, Value::Object(wrapper), mc),
+    }
+    Some(wrapper)
+}
+
+/// Новый полигон резки: клон материала и геометрии исходной грани, учёт в цепочке кадра.
+fn conflict_new_face<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    ctx: &ConflictCtx<'gc>,
+    source: Object<'gc>,
+) -> Option<Object<'gc>> {
+    let slots = &ctx.slots;
+    let face = conflict_take(
+        activation,
+        ctx.face_class,
+        slots.face_collector,
+        slots.face_next,
+        slots.face_vtable,
+    )?;
+    let mc = activation.gc();
+    face.set_slot_no_coerce(slots.face_material, source.get_slot(slots.face_material), mc);
+    face.set_slot_no_coerce(slots.face_geometry, source.get_slot(slots.face_geometry), mc);
+    if let Some(last) = ctx.camera.get_slot(slots.camera_last_face).as_object() {
+        last.set_slot_no_coerce(slots.face_next, Value::Object(face), mc);
+    }
+    ctx.camera
+        .set_slot_no_coerce(slots.camera_last_face, Value::Object(face), mc);
+    Some(face)
+}
+
+/// `Camera3D.sortByAverageZ` — сортировка слиянием связного списка граней по средней глубине
+/// вершин; глубина листьев пересчитывается на месте. Дословный перенос байткода.
+fn sort_by_average_z<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    slots: &ConflictSlots,
+    head: Object<'gc>,
+) -> Option<Object<'gc>> {
+    let mc = activation.gc();
+    let next_of = |face: Object<'gc>| face.get_slot(slots.face_process_next).as_object();
+
+    // Быстрый и медленный указатели делят список пополам.
+    let mut middle = head;
+    let mut probe = next_of(head);
+    while let Some(fast) = probe
+        && next_of(fast).is_some()
+    {
+        middle = next_of(middle)?;
+        probe = next_of(next_of(fast)?);
+    }
+    let mut right = next_of(middle);
+    middle.set_slot_no_coerce(slots.face_process_next, Value::Null, mc);
+    let mut left = Some(head);
+
+    // Каждая половина либо сортируется глубже, либо (одиночная грань) получает глубину.
+    let refresh = |face: Object<'gc>, mc: &Mutation<'gc>| {
+        let mut count = 0i32;
+        let mut sum = 0.0f64;
+        let mut link = face.get_slot(slots.face_wrapper).as_object();
+        while let Some(wrapper) = link {
+            count += 1;
+            if let Some(vertex) = wrapper.get_slot(slots.wrapper_vertex).as_object() {
+                sum += conflict_num(vertex, slots.vertex_camera[2]);
+            } else {
+                sum += f64::NAN;
+            }
+            link = wrapper.get_slot(slots.wrapper_next).as_object();
+        }
+        set(face, slots.face_distance, sum / f64::from(count), mc);
+    };
+    let left_head = left?;
+    if next_of(left_head).is_some() {
+        left = Some(sort_by_average_z(activation, slots, left_head)?);
+    } else {
+        refresh(left_head, mc);
+    }
+    let right_head = right?;
+    if next_of(right_head).is_some() {
+        right = Some(sort_by_average_z(activation, slots, right_head)?);
+    } else {
+        refresh(right_head, mc);
+    }
+
+    // Слияние на месте: пока берём из той же половины, ссылки уже стоят.
+    let distance = |face: Object<'gc>| conflict_num(face, slots.face_distance);
+    let (mut left, mut right) = (left?, right?);
+    let mut from_left = distance(left) > distance(right);
+    let result;
+    let mut tail;
+    if from_left {
+        result = left;
+        tail = left;
+        match next_of(left) {
+            Some(next) => left = next,
+            None => {
+                tail.set_slot_no_coerce(slots.face_process_next, Value::Object(right), mc);
+                return Some(result);
+            }
+        }
+    } else {
+        result = right;
+        tail = right;
+        match next_of(right) {
+            Some(next) => right = next,
+            None => {
+                tail.set_slot_no_coerce(slots.face_process_next, Value::Object(left), mc);
+                return Some(result);
+            }
+        }
+    }
+    loop {
+        if from_left {
+            if distance(left) > distance(right) {
+                tail = left;
+                match next_of(left) {
+                    Some(next) => left = next,
+                    None => {
+                        tail.set_slot_no_coerce(
+                            slots.face_process_next,
+                            Value::Object(right),
+                            mc,
+                        );
+                        return Some(result);
+                    }
+                }
+            } else {
+                tail.set_slot_no_coerce(slots.face_process_next, Value::Object(right), mc);
+                tail = right;
+                match next_of(right) {
+                    Some(next) => right = next,
+                    None => {
+                        tail.set_slot_no_coerce(slots.face_process_next, Value::Object(left), mc);
+                        return Some(result);
+                    }
+                }
+                from_left = false;
+            }
+        } else if distance(right) > distance(left) {
+            tail = right;
+            match next_of(right) {
+                Some(next) => right = next,
+                None => {
+                    tail.set_slot_no_coerce(slots.face_process_next, Value::Object(left), mc);
+                    return Some(result);
+                }
+            }
+        } else {
+            tail.set_slot_no_coerce(slots.face_process_next, Value::Object(left), mc);
+            tail = left;
+            match next_of(left) {
+                Some(next) => left = next,
+                None => {
+                    tail.set_slot_no_coerce(slots.face_process_next, Value::Object(right), mc);
+                    return Some(result);
+                }
+            }
+            from_left = true;
+        }
+    }
