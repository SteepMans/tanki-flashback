+        // AGAL lets a swizzle name components the source register does not have: reading `.z` of a
+        // float2 attribute is legal there and yields the register's padding. Naga is stricter and
+        // rejects the module ("Swizzle component Z is outside of vector size Bi"), which aborts
+        // shader compilation and takes the whole player down with it. Widen the source to a vec4
+        // (padded with 0,0,0,1, matching how Flash fills unused components) whenever the swizzle
+        // reaches past it, so the pattern is always in range.
+        let used_components = swizzle_flags.iter().copied().max().unwrap_or(0) + 1;
+        let available_components = match source_type {
+            VertexAttributeFormat::Float1 => 1,
+            VertexAttributeFormat::Float2 => 2,
+            VertexAttributeFormat::Float3 => 3,
+            VertexAttributeFormat::Float4 | VertexAttributeFormat::Bytes4 => 4,
+        };
+
+        if used_components > available_components && source_type != VertexAttributeFormat::Float4 {
+            base_expr = source_type.extend_to_float4(base_expr, self)?;
+        }
