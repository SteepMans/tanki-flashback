             } else {
                 RenderBlendMode::Builtin(blend_mode.try_into().unwrap())
             };
-            context.commands.blend(sub_commands, render_blend_mode);
+            // Erase punches a hole through the layer it sits in — that is how Flash content cuts a
+            // window in the UI for the Stage3D layer underneath (ProTanki does this for the garage
+            // tank preview). Ruffle's layer tracking does not reach the erase through the
+            // intermediate containers this content uses, so the rect was composited as an opaque
+            // fill and covered the 3D view. Dropping it leaves the hole, which is what the content
+            // expects; erasing already-drawn pixels of the same layer is not supported either way.
+            if matches!(blend_mode, ExtendedBlendMode::Erase) {
+                // nothing to draw: the hole is the effect
+            } else {
+                context.commands.blend(sub_commands, render_blend_mode);
+            }
         }
     }
 
