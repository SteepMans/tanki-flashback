From 3aa08dfcd958c9bbf265b4613227fffff431dede Mon Sep 17 00:00:00 2001
From: Konstantin <38701987+SteepMans@users.noreply.github.com>
Date: Mon, 17 Aug 2026 23:34:41 +0300
Subject: [PATCH 1/2] core: stop building a method name string on every call

---
 core/src/avm2/method.rs       |  6 +++
 core/src/avm2/method_stats.rs | 90 ++++++++++++++++++++++++++++-------
 2 files changed, 78 insertions(+), 18 deletions(-)

diff --git a/core/src/avm2/method.rs b/core/src/avm2/method.rs
index 075477d5..c730bf27 100644
--- a/core/src/avm2/method.rs
+++ b/core/src/avm2/method.rs
@@ -155,6 +155,12 @@ impl core::fmt::Debug for Method<'_> {
 }
 
 impl<'gc> Method<'gc> {
+    /// Адрес метода — постоянный ключ для счётчиков профилировщика. Нужен, чтобы не собирать
+    /// имя метода строкой на каждом вызове: имя строится один раз и кладётся рядом с этим ключом.
+    pub fn identity(self) -> usize {
+        Gc::as_ptr(self.0) as usize
+    }
+
     /// Construct a `Method` from an `AbcFile` and method index.
     pub fn from_method_index(
         txunit: TranslationUnit<'gc>,
diff --git a/core/src/avm2/method_stats.rs b/core/src/avm2/method_stats.rs
index 91b0389b..9e3be700 100644
--- a/core/src/avm2/method_stats.rs
+++ b/core/src/avm2/method_stats.rs
@@ -36,11 +36,16 @@ thread_local! {
     /// Всего выполнено инструкций и вызовов за период. По ним считается пропускная способность
     /// интерпретатора (инструкций на миллисекунду) — метрика, не зависящая от сцены.
     static TOTAL: Cell<(u64, u64)> = const { Cell::new((0, 0)) };
-    /// Имя метода -> (инструкций, вызовов).
-    static TOTALS: RefCell<HashMap<String, (u64, u64)>> = RefCell::new(HashMap::new());
+    /// Метод -> (инструкций, вызовов). Ключ — адрес метода, а не имя: счётчик обновляется на
+    /// КАЖДОМ вызове (у клиента около миллиона в секунду), и сборка имени строкой стоила там
+    /// дороже, чем всё остальное измерение вместе взятое.
+    static TOTALS: RefCell<HashMap<usize, (u64, u64)>> = RefCell::new(HashMap::new());
     /// То же самое, но копится ровно один кадр: по нему объясняется провал частоты — какой код
     /// игры съел именно этот кадр. За секунду такая просадка растворяется и не видна.
-    static FRAME: RefCell<HashMap<String, (u64, u64)>> = RefCell::new(HashMap::new());
+    static FRAME: RefCell<HashMap<usize, (u64, u64)>> = RefCell::new(HashMap::new());
+    /// Имена методов по их адресу. Заполняется один раз на метод за сессию; адрес постоянен,
+    /// пока метод жив, а живут они у игры от загрузки до выхода.
+    static NAMES: RefCell<HashMap<usize, String>> = RefCell::new(HashMap::new());
     /// Счётчики по видам инструкций. Массив ячеек, а не словарь: считаем на КАЖДОЙ инструкции,
     /// и словарь со строковым ключом обходился в разы дороже самого интерпретатора.
     static OPS: [Cell<u64>; OP_KINDS.len()] = const { [const { Cell::new(0) }; OP_KINDS.len()] };
@@ -91,6 +96,20 @@ pub fn fast_type_checks() -> bool {
     FAST_TYPE_CHECKS.load(Ordering::Relaxed)
 }
 
+/// Отдельная строка на каждый провал кадра. По умолчанию выключено: при частоте 25 кадров в
+/// секунду и сплошных провалах это два-три десятка строк в секунду, консоль в них тонет, а сама
+/// печать съедает кадр и портит замер. Включается со страницы `window.ruffleHitchEveryFrame`.
+static HITCH_EVERY_FRAME: AtomicBool = AtomicBool::new(false);
+
+pub fn set_hitch_every_frame(value: bool) {
+    HITCH_EVERY_FRAME.store(value, Ordering::Relaxed);
+}
+
+#[inline(always)]
+pub fn hitch_every_frame() -> bool {
+    HITCH_EVERY_FRAME.load(Ordering::Relaxed)
+}
+
 pub fn set_native_paths_enabled(value: bool) {
     NATIVE_PATHS_ENABLED.store(value, Ordering::Relaxed);
 }
@@ -129,24 +148,52 @@ fn label(method: Method<'_>) -> String {
 }
 
 pub fn record(method: Method<'_>, ops: u64) {
-    FRAME.with(|frame| {
-        let mut frame = frame.borrow_mut();
-        let entry = frame.entry(label(method)).or_insert((0, 0));
-        entry.0 += ops;
-        entry.1 += 1;
-    });
+    let key = method.identity();
+    // Покадровый разбор копится только когда его кто-то спросит: это лишний поиск в словаре на
+    // каждом вызове, а вызовов у клиента около миллиона в секунду.
+    if hitch_every_frame() {
+        FRAME.with(|frame| {
+            let mut frame = frame.borrow_mut();
+            let entry = frame.entry(key).or_insert((0, 0));
+            entry.0 += ops;
+            entry.1 += 1;
+        });
+    }
     TOTAL.with(|total| {
         let (all_ops, all_calls) = total.get();
         total.set((all_ops + ops, all_calls + 1));
     });
     TOTALS.with(|totals| {
         let mut totals = totals.borrow_mut();
-        let entry = totals.entry(label(method)).or_insert((0, 0));
-        entry.0 += ops;
-        entry.1 += 1;
+        match totals.entry(key) {
+            std::collections::hash_map::Entry::Occupied(mut entry) => {
+                let entry = entry.get_mut();
+                entry.0 += ops;
+                entry.1 += 1;
+            }
+            std::collections::hash_map::Entry::Vacant(entry) => {
+                // Имя строится только когда метод встретился впервые за сессию.
+                NAMES.with(|names| {
+                    names.borrow_mut().entry(key).or_insert_with(|| label(method));
+                });
+                entry.insert((ops, 1));
+            }
+        }
     });
 }
 
+/// Имя метода по ключу счётчика. Неизвестный ключ бывает только у метода, который успели собрать
+/// как мусор и на его месте оказался другой — в профилировщике это не страшно.
+fn name_of(key: usize) -> String {
+    NAMES.with(|names| {
+        names
+            .borrow()
+            .get(&key)
+            .cloned()
+            .unwrap_or_else(|| format!("метод@{key:x}"))
+    })
+}
+
 /// Виды инструкций для гистограммы. Отдельно выделены обращения к полям: у Ruffle их несколько
 /// видов, и по соотношению видно, справился ли анализатор — Slot дешёвый, Slow ищет имя в таблице.
 pub const OP_KINDS: [&str; 22] = [
@@ -247,14 +294,18 @@ pub fn take_ops() -> Vec<(&'static str, u64)> {
 /// Самые дорогие методы ТЕКУЩЕГО кадра и сколько всего инструкций в нём выполнено.
 /// Счётчики кадра обнуляются — их надо снимать каждый кадр.
 pub fn take_frame_top(limit: usize) -> (Vec<(String, u64)>, u64) {
-    FRAME.with(|frame| {
+    let (mut rows, total) = FRAME.with(|frame| {
         let mut frame = frame.borrow_mut();
         let total: u64 = frame.values().map(|(ops, _)| ops).sum();
-        let mut rows: Vec<_> = frame.drain().map(|(name, (ops, _))| (name, ops)).collect();
+        let mut rows: Vec<_> = frame.drain().map(|(key, (ops, _))| (key, ops)).collect();
         rows.sort_by(|a, b| b.1.cmp(&a.1));
         rows.truncate(limit);
         (rows, total)
-    })
+    });
+    (
+        rows.drain(..).map(|(key, ops)| (name_of(key), ops)).collect(),
+        total,
+    )
 }
 
 /// Забыть счётчики кадра, ничего не разбирая: кадр уложился в бюджет.
@@ -269,14 +320,17 @@ pub fn take_total() -> (u64, u64) {
 
 /// Верхушка списка по числу инструкций. Счётчики обнуляются, чтобы каждая выдача была за период.
 pub fn take_top(limit: usize) -> Vec<(String, u64, u64)> {
-    TOTALS.with(|totals| {
+    let mut rows = TOTALS.with(|totals| {
         let mut totals = totals.borrow_mut();
         let mut rows: Vec<_> = totals
             .drain()
-            .map(|(name, (ops, calls))| (name, ops, calls))
+            .map(|(key, (ops, calls))| (key, ops, calls))
             .collect();
         rows.sort_by(|a, b| b.1.cmp(&a.1));
         rows.truncate(limit);
         rows
-    })
+    });
+    rows.drain(..)
+        .map(|(key, ops, calls)| (name_of(key), ops, calls))
+        .collect()
 }
