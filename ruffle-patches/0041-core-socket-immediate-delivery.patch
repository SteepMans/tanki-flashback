+/// Замер пути данных сокета. Игровой пинг складывается из сети и обеих обвязок, и без этих цифр
+/// нельзя сказать, где очередь: браузерная часть отмечает момент прихода WS-сообщения, плеер —
+/// момент, когда байты отданы ActionScript. Разница и есть вклад эмулятора во входящую половину
+/// пинга. Для исходящей половины то же самое: от `flush()` в ActionScript до фактической отправки
+/// в WebSocket.
+///
+/// Пары «пришло → доставлено» сходятся по FIFO: и запись, и чтение происходят в одном потоке
+/// (в браузере всё исполняется в главном), а действия в канале плеера не обгоняют друг друга.
+static SOCKET_PROBE: AtomicBool = AtomicBool::new(false);
+
+/// Немедленная доставка входящих данных сокета (будить плеер на каждом WS-сообщении, не ждать
+/// кадра). Отключается со страницы `window.ruffleNoSocketWake = true` — для сравнения «до/после»
+/// на одной сборке.
+static SOCKET_WAKE: AtomicBool = AtomicBool::new(true);
+
+thread_local! {
+    /// Моменты прихода входящих порций из сети, ещё не отданных ActionScript.
+    static SOCKET_IN_ARRIVALS: RefCell<VecDeque<Instant>> = const { RefCell::new(VecDeque::new()) };
+    /// (сумма мс, максимум мс, порций) времени «пришло из сети → отдано ActionScript» за период.
+    static SOCKET_IN_LAG: Cell<(f64, f64, u64)> = const { Cell::new((0.0, 0.0, 0)) };
+    /// Моменты, когда ActionScript отдал порции на отправку, ещё не ушедшие в WebSocket.
+    static SOCKET_OUT_STARTS: RefCell<VecDeque<Instant>> = const { RefCell::new(VecDeque::new()) };
+    /// (сумма мс, максимум мс, порций) времени «flush() → отправлено в WebSocket» за период.
+    static SOCKET_OUT_LAG: Cell<(f64, f64, u64)> = const { Cell::new((0.0, 0.0, 0)) };
+}
+
+/// Включается обвязкой, которая отмечает приход и отправку (сейчас — только web). Пока выключено,
+/// плеер не копит моменты, и настольная сборка не собирает очередь, которую некому разбирать.
+pub fn enable_socket_probe() {
+    SOCKET_PROBE.store(true, Ordering::Relaxed);
+}
+
+pub fn socket_probe() -> bool {
+    SOCKET_PROBE.load(Ordering::Relaxed)
+}
+
+pub fn set_socket_wake_enabled(value: bool) {
+    SOCKET_WAKE.store(value, Ordering::Relaxed);
+}
+
+pub fn socket_wake_enabled() -> bool {
+    SOCKET_WAKE.load(Ordering::Relaxed)
+}
+
+/// Пришла порция данных сокета из сети (вызывает web-обвязка при WS-сообщении).
+pub fn record_socket_in_arrival() {
+    SOCKET_IN_ARRIVALS.with(|queue| {
+        let mut queue = queue.borrow_mut();
+        // Предохранитель от бесконечного роста, если доставки почему-то не происходят.
+        if queue.len() < 4096 {
+            queue.push_back(Instant::now());
+        }
+    });
+}
+
+/// Плеер отдал порцию данных сокета ActionScript.
+pub fn record_socket_in_delivery() {
+    SOCKET_IN_ARRIVALS.with(|queue| {
+        if let Some(arrived) = queue.borrow_mut().pop_front() {
+            let ms = arrived.elapsed().as_secs_f64() * 1000.0;
+            SOCKET_IN_LAG.with(|lag| {
+                let (sum, max, count) = lag.get();
+                lag.set((sum + ms, max.max(ms), count + 1));
+            });
+        }
+    });
+}
+
+/// ActionScript отдал порцию на отправку (`Socket.flush()` дошёл до канала обвязки).
+pub fn record_socket_out_enqueued() {
+    if !socket_probe() {
+        return;
+    }
+    SOCKET_OUT_STARTS.with(|queue| {
+        let mut queue = queue.borrow_mut();
+        if queue.len() < 4096 {
+            queue.push_back(Instant::now());
+        }
+    });
+}
+
+/// Обвязка отправила порцию в WebSocket (или окончательно не смогла — пара всё равно снимается,
+/// чтобы очередь не разъехалась).
+pub fn record_socket_out_sent() {
+    SOCKET_OUT_STARTS.with(|queue| {
+        if let Some(started) = queue.borrow_mut().pop_front() {
+            let ms = started.elapsed().as_secs_f64() * 1000.0;
+            SOCKET_OUT_LAG.with(|lag| {
+                let (sum, max, count) = lag.get();
+                lag.set((sum + ms, max.max(ms), count + 1));
+            });
+        }
+    });
+}
+
+/// Соединение закрылось: неотправленные порции уже никогда не отправятся, их моменты снимаются,
+/// чтобы не испортить пары следующего соединения.
+pub fn reset_socket_out_queue() {
+    SOCKET_OUT_STARTS.with(|queue| queue.borrow_mut().clear());
+}
+
+/// (сумма мс, максимум мс, порций) входящей задержки за период; счётчики обнуляются.
+pub fn take_socket_in_lag() -> (f64, f64, u64) {
+    SOCKET_IN_LAG.with(|lag| lag.replace((0.0, 0.0, 0)))
+}
+
+/// (сумма мс, максимум мс, порций) исходящей задержки за период; счётчики обнуляются.
+pub fn take_socket_out_lag() -> (f64, f64, u64) {
+    SOCKET_OUT_LAG.with(|lag| lag.replace((0.0, 0.0, 0)))
+}
+
 /// Всего инструкций и вызовов за период; счётчики обнуляются.
 pub fn take_total() -> (u64, u64) {
     TOTAL.with(|total| total.replace((0, 0)))
