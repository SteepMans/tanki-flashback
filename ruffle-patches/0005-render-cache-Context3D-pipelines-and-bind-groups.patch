+// Константы шейдеров хранятся не одним набором, а кольцом наборов: каждый вызов отрисовки
+// получает свой слот, а шейдер читает его через смещение при привязке bind group. Без этого
+// пришлось бы отправлять команды видеокарте после каждого drawTriangles (константы менялись бы
+// под уже записанными вызовами) — а именно посабмитная отправка и съедала кадры: на карте
+// «Иран» клиент рисует около 200 моделей за кадр.
+//
+// Смещение должно быть кратно 256 байтам (требование wgpu), поэтому слот фрагментных констант
+// округлён вверх.
+pub(super) const VERTEX_UNIFORM_SLOT_SIZE: u64 = VERTEX_SHADER_UNIFORMS_BUFFER_SIZE;
+pub(super) const FRAGMENT_UNIFORM_SLOT_SIZE: u64 = 512;
+pub(super) const UNIFORM_SLOT_COUNT: u64 = 1024;
+
 // The flash Context3D API is similar to OpenGL - it has many methods
 // which modify the current state (`setVertexBufferAt`, `setCulling`, etc.)
 // These methods can be called at any time.
@@ -125,8 +138,64 @@ pub struct CurrentPipeline {
     // (which allows rendering with an 'ignoresampler' tex opcode,
     // and no calls to Context3D.setSamplerStateAt)
     sampler_configs: [SamplerConfig; 8],
+
+    // Кеши готовых объектов. Клиент перед каждой моделью зовёт setTextureAt/setVertexBufferAt,
+    // из-за чего состояние помечается «грязным» и раньше пайплайн с bind group создавались
+    // заново на КАЖДЫЙ drawTriangles. Создание пайплайна — это компиляция и линковка программы
+    // на стороне драйвера (в WebGL — glLinkProgram), то есть миллисекунды на вызов; при сотнях
+    // моделей в кадре это и есть основная причина низкого FPS. Оба объекта зависят только от
+    // состояния, поэтому переиспользуются по ключу.
+    pipelines: RefCell<HashMap<PipelineKey, wgpu::RenderPipeline>>,
+    bind_groups: RefCell<HashMap<BindGroupKey, BindGroupEntryCache>>,
+    pub created_pipelines: Cell<u32>,
+    pub created_bind_groups: Cell<u32>,
+
+    /// Отладочный выключатель кешей (`window.ruffleNoCache`) — чтобы отличать ошибки
+    /// переиспользования готовых объектов от ошибок самой сцены.
+    pub no_cache: Cell<bool>,
 }
 
+/// Ключ кеша пайплайнов: всё, что попадает в `RenderPipelineDescriptor`. Конкретные вершинные
+/// буферы в ключ не входят — важна только их раскладка, поэтому одинаковые по формату меши
+/// делят один пайплайн.
+#[derive(PartialEq, Eq, Hash)]
+struct PipelineKey {
+    shaders: usize,
+    texture_infos: [Option<ShaderTextureInfo>; 8],
+    vertex_layouts: Vec<(u64, Vec<(u32, wgpu::VertexFormat, u64)>)>,
+    culling: u8,
+    color_mask: wgpu::ColorWrites,
+    has_depth_texture: bool,
+    depth_mask: bool,
+    pass_compare_mode: wgpu::CompareFunction,
+    stencil: wgpu::StencilState,
+    color_component: wgpu::BlendComponent,
+    alpha_component: wgpu::BlendComponent,
+    sample_count: u32,
+    target_format: TextureFormat,
+}
+
+/// Ключ кеша bind group: раскладка (она задаётся шейдерами и набором текстурных слотов),
+/// сами текстуры и настройки семплеров.
+#[derive(PartialEq, Eq, Hash)]
+struct BindGroupKey {
+    shaders: usize,
+    texture_infos: [Option<ShaderTextureInfo>; 8],
+    textures: [Option<(usize, bool)>; 8],
+    samplers: [SamplerConfig; 8],
+}
+
+/// Записи кеша держат сами текстуры живыми: иначе освобождённый `Rc` мог бы уступить свой адрес
+/// новой текстуре, и ключ совпал бы с чужим объектом.
+struct BindGroupEntryCache {
+    bind_group: wgpu::BindGroup,
+    _textures: Vec<Rc<dyn Texture>>,
+}
+
+/// Предохранитель от неограниченного роста: сцена использует десятки состояний, но текстур в
+/// гараже и на карте много, поэтому кеши изредка сбрасываются целиком.
+const MAX_CACHE_ENTRIES: usize = 512;
