-        self.bound_textures[index] = texture;
+        // Клиент перед каждой моделью заново привязывает те же текстуры. Сравниваем сами объекты
+        // (у `Rc<dyn Texture>` сравниваем адрес данных, минуя таблицу методов) — если ничего не
+        // изменилось, состояние остаётся чистым и bind group не пересобирается.
+        let unchanged = !self.no_cache.get()
+            && match (&self.bound_textures[index], &texture) {
+            (None, None) => true,
+            (Some(old), Some(new)) => {
+                old.cube == new.cube
+                    && std::ptr::eq(
+                        Rc::as_ptr(&old.id) as *const (),
+                        Rc::as_ptr(&new.id) as *const (),
+                    )
+            }
+            _ => false,
+            };
+
+        if !unchanged {
+            self.dirty.set(true);
+            self.bound_textures[index] = texture;
+        }
     }
 
