From: Konstantin <38701987+SteepMans@users.noreply.github.com>
Date: Sun, 16 Aug 2026 04:50:03 +0300
Subject: [PATCH 08/17] core: retry Stage3D texture uploads that arrived empty

---
 .../avm2/globals/flash/display/bitmap_data.rs | 10 +++
 .../globals/flash/display3D/context_3d.rs     |  5 +-
 .../display3D/textures/rectangle_texture.rs   | 22 +++++
 .../flash/display3D/textures/texture.rs       | 20 +++++
 core/src/avm2/object/context3d_object.rs      | 90 ++++++++++++++++++-
 core/src/bitmap/bitmap_data.rs                |  9 ++
 6 files changed, 154 insertions(+), 2 deletions(-)

diff --git a/core/src/avm2/globals/flash/display/bitmap_data.rs b/core/src/avm2/globals/flash/display/bitmap_data.rs
index 9575d3bd..83ce0d1f 100644
--- a/core/src/avm2/globals/flash/display/bitmap_data.rs
+++ b/core/src/avm2/globals/flash/display/bitmap_data.rs
@@ -1100,6 +1100,16 @@ pub fn dispose<'gc>(
     let this = this.as_object().unwrap();
 
     if let Some(bitmap_data) = this.as_bitmap_data() {
+        // Картинка могла быть залита в текстуру Stage3D ещё пустой (клиент заполняет её позже,
+        // а в Ruffle события загрузки приходят с задержкой). Освобождение — последний момент,
+        // когда содержимое ещё доступно: успеваем перезалить.
+        let stage3ds: Vec<_> = activation.context.stage.stage3ds().iter().copied().collect();
+        for stage3d in stage3ds {
+            if let Some(context3d) = stage3d.context3d() {
+                context3d.retry_empty_uploads(activation.context, true);
+            }
+        }
+
         // Don't check if we've already disposed this BitmapData - 'BitmapData.dispose()' can be called
         // multiple times
         bitmap_data.dispose(activation.gc());
diff --git a/core/src/avm2/globals/flash/display3D/context_3d.rs b/core/src/avm2/globals/flash/display3D/context_3d.rs
index 55bfe418..1bfc6ade 100644
--- a/core/src/avm2/globals/flash/display3D/context_3d.rs
+++ b/core/src/avm2/globals/flash/display3D/context_3d.rs
@@ -210,13 +210,16 @@ pub fn draw_triangles<'gc>(
 }
 
 pub fn present<'gc>(
-    _activation: &mut Activation<'_, 'gc>,
+    activation: &mut Activation<'_, 'gc>,
     this: Value<'gc>,
     _args: &[Value<'gc>],
 ) -> Result<Value<'gc>, Error<'gc>> {
     let this = this.as_object().unwrap();
 
     if let Some(context) = this.as_context_3d() {
+        // Заливки, приехавшие пустыми, повторяем в начале кадра: к этому моменту картинка
+        // могла догрузиться.
+        context.retry_empty_uploads(activation.context, false);
         context.present();
     }
     Ok(Value::Undefined)
diff --git a/core/src/avm2/globals/flash/display3D/textures/rectangle_texture.rs b/core/src/avm2/globals/flash/display3D/textures/rectangle_texture.rs
index ce7d83ab..e02ec889 100644
--- a/core/src/avm2/globals/flash/display3D/textures/rectangle_texture.rs
+++ b/core/src/avm2/globals/flash/display3D/textures/rectangle_texture.rs
@@ -31,11 +31,33 @@ pub fn upload_from_bitmap_data<'gc>(
         let source_obj = args.get_object(activation, 0, "source")?;
 
         if let Some(source) = source_obj.as_bitmap_data() {
+            // Клиент грузит картинки асинхронно и иногда заливает текстуру раньше, чем
+            // изображение приедет: в Ruffle события загрузки приходят позже, чем во Flash.
+            // Такую заливку запоминаем и повторяем, иначе текстура навсегда останется чёрной
+            // (в ProTanki так пропадали ящики припасов).
+            let empty = {
+                let data = source.sync(activation.context.renderer);
+                let data = data.borrow();
+                data.pixels_rgba()
+                    .chunks_exact(4)
+                    .step_by(16)
+                    .all(|pixel| pixel == [0, 0, 0, 0])
+            };
+
             texture.context3d().copy_bitmapdata_to_texture(
                 &source.sync(activation.context.renderer).borrow(),
                 texture.handle(),
                 0,
             );
+
+            if empty {
+                texture.context3d().remember_empty_upload(
+                    activation.gc(),
+                    texture.handle(),
+                    source,
+                    0,
+                );
+            }
         } else {
             unreachable!("Argument is BitmapData-typed");
         }
