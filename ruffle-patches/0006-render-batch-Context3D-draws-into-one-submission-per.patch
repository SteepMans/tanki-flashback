+            ),
+            ("submits", self.stats.submits as f64 / self.stats.frames as f64),
+            (
+                "commandMs",
+                self.stats.command_time.as_secs_f64() * 1000.0 / self.stats.frames as f64,
+            ),
+            ("commands", self.stats.commands as f64 / self.stats.frames as f64),
+            ("pipelines", self.current_pipeline.created_pipelines.get() as f64),
+            (
