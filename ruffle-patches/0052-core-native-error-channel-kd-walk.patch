+/// То же, что `slot_of`, но по таблице методов класса — без живого экземпляра. Нужно, когда
+/// экземпляров ещё нет, а класс уже известен (например, статические пулы).
+fn slot_of_vtable<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    vtable: crate::avm2::vtable::VTable<'gc>,
+    name: &'static str,
+    engine_namespace: bool,
+) -> Option<usize> {
+    let name = AvmString::new_utf8(activation.gc(), name);
+    let namespace = if engine_namespace {
+        crate::avm2::namespace::Namespace::package(
+            AvmString::new_utf8(activation.gc(), ENGINE_NS),
+            crate::avm2::api_version::ApiVersion::VM_INTERNAL,
+            activation.strings(),
+        )
+    } else {
+        activation.avm2().namespaces.public_vm_internal()
+    };
+    match vtable.get_trait(&Multiname::new(namespace, name)) {
+        Some(Property::Slot { slot_id }) | Some(Property::ConstSlot { slot_id }) => Some(slot_id),
+        _ => None,
+    }
+}
