+/// Пересекает ли сфера габаритный ящик — общее ядро для нативных вызовов и самой замены.
+fn sphere_hits_bound(sphere: &[f64; 4], bound: &[f64; 6]) -> bool {
+    let [x, y, z, w] = *sphere;
+    x + w > bound[0]
+        && x - w < bound[3]
+        && y + w > bound[1]
+        && y - w < bound[4]
+        && z + w > bound[2]
+        && z - w < bound[5]
+}
+
+/// Номера слотов обхода KD-дерева при вставке динамики.
+#[derive(Clone, Copy)]
+struct KdSlots {
+    node_negative: usize,
+    node_positive: usize,
+    node_axis: usize,
+    node_coord: usize,
+    node_bound: [usize; 6],
+    node_object_list: usize,
+    node_object_bound_list: usize,
+    /// next и габариты на Object3D (общие для наследников).
+    object_next: usize,
+    object_bound: [usize; 6],
+    node_vtable: u32,
+}
+
+thread_local! {
+    static KD_SLOTS: RefCell<Option<KdSlots>> = const { RefCell::new(None) };
+    static KD_HOPELESS: Cell<bool> = const { Cell::new(false) };
+}
+
+fn kd_slots<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    node: Object<'gc>,
+    sample_object: Object<'gc>,
+) -> Option<KdSlots> {
+    if let Some(slots) = KD_SLOTS.with(|cache| *cache.borrow()) {
+        return Some(slots);
+    }
+    if KD_HOPELESS.with(|flag| flag.get()) {
+        return None;
+    }
+
+    // Имена габаритов и полей узла могут жить и в движковом, и в открытом пространстве имён —
+    // пробуем оба.
+    let any_ns = |activation: &mut Activation<'_, 'gc>, object: Object<'gc>, name| {
+        slot_of(activation, object, name, false).or_else(|| slot_of(activation, object, name, true))
+    };
+    let resolve = |activation: &mut Activation<'_, 'gc>| -> Option<KdSlots> {
+        let bound_names = [
+            "boundMinX", "boundMinY", "boundMinZ", "boundMaxX", "boundMaxY", "boundMaxZ",
+        ];
+        let mut node_bound = [0usize; 6];
+        let mut object_bound = [0usize; 6];
+        for at in 0..6 {
+            node_bound[at] = any_ns(activation, node, bound_names[at])?;
+            object_bound[at] = any_ns(activation, sample_object, bound_names[at])?;
+        }
+        Some(KdSlots {
+            node_negative: any_ns(activation, node, "negative")?,
+            node_positive: any_ns(activation, node, "positive")?,
+            node_axis: any_ns(activation, node, "axis")?,
+            node_coord: any_ns(activation, node, "coord")?,
+            node_bound,
+            node_object_list: any_ns(activation, node, "objectList")?,
+            node_object_bound_list: any_ns(activation, node, "objectBoundList")?,
+            object_next: slot_of(activation, sample_object, "next", true)?,
+            object_bound,
+            node_vtable: node.vtable().id(),
+        })
+    };
+    match resolve(activation) {
+        Some(slots) => {
+            KD_SLOTS.with(|cache| *cache.borrow_mut() = Some(slots));
+            Some(slots)
+        }
+        None => {
+            KD_HOPELESS.with(|flag| flag.set(true));
+            None
+        }
+    }
+}
+
+/// Аргументы обхода, не меняющиеся по рекурсии.
+struct KdCall<'gc> {
+    this: Object<'gc>,
+    /// Сфера — ОБЩАЯ статическая заготовка контейнеров: вложенный collectPlanes другого
+    /// контейнера пересчитает её прямо посреди обхода. Байткод перечитывает координаты при
+    /// каждом использовании — делаем так же, кэшировать их нельзя.
+    sphere: Object<'gc>,
+    sphere_slots: Vector3dSlots,
+    /// Пять плоскостей, вектор и словарь исключений — пробрасываются в collectPlanes как есть.
+    passthrough: [Value<'gc>; 7],
+    compose: Multiname<'gc>,
+    collect: Multiname<'gc>,
+}
+
+fn kd_bound_of<'gc>(object: Object<'gc>, slots: &[usize; 6]) -> [f64; 6] {
+    let mut out = [0.0f64; 6];
+    for at in 0..6 {
+        out[at] = object.get_slot(slots[at]).try_as_f64().unwrap_or(f64::NAN);
+    }
+    out
+}
+
+/// Обход одного узла. Ошибка — исключение из collectPlanes, летит наружу как есть.
+fn kd_walk<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+    call: &KdCall<'gc>,
+    slots: &KdSlots,
+    node: Object<'gc>,
+    depth: u32,
+) -> Result<Option<()>, crate::avm2::Error<'gc>> {
+    if depth > 512 || node.vtable().id() != slots.node_vtable {
+        return Ok(None);
+    }
+    let link = |object: Object<'gc>, slot: usize| object.get_slot(slot).as_object();
+    let sphere_now = || read_vector3d(call.sphere, &call.sphere_slots);
+
+    // Обработка списка объектов узла: свёртка матрицы и сбор плоскостей интерпретатором.
+    let process = |activation: &mut Activation<'_, 'gc>,
+                       object: Object<'gc>|
+     -> Result<(), crate::avm2::Error<'gc>> {
+        Value::Object(object).call_property(
+            &call.compose,
+            crate::avm2::function::FunctionArgs::from_slice(&[Value::Object(call.this)]),
+            activation,
+        )?;
+        Value::Object(object).call_property(
+            &call.collect,
+            crate::avm2::function::FunctionArgs::from_slice(&call.passthrough),
+            activation,
+        )?;
+        Ok(())
+    };
+
+    if let Some(negative) = link(node, slots.node_negative) {
+        let sphere = sphere_now();
+        let axis = node.get_slot(slots.node_axis);
+        let value = if axis == Value::Integer(0) {
+            sphere[0]
+        } else if axis == Value::Integer(1) {
+            sphere[1]
+        } else {
+            sphere[2]
+        };
+        let distance = value - node.get_slot(slots.node_coord).try_as_f64().unwrap_or(f64::NAN);
+        let positive = link(node, slots.node_positive);
+
+        if distance >= sphere[3] {
+            if let Some(positive) = positive
+                && sphere_hits_bound(&sphere_now(), &kd_bound_of(positive, &slots.node_bound))
+                && kd_walk(activation, call, slots, positive, depth + 1)?.is_none()
+            {
+                return Ok(None);
+            }
+        } else if distance <= -sphere[3] {
+            if sphere_hits_bound(&sphere_now(), &kd_bound_of(negative, &slots.node_bound))
+                && kd_walk(activation, call, slots, negative, depth + 1)?.is_none()
+            {
+                return Ok(None);
+            }
+        } else {
+            let mut object = link(node, slots.node_object_list);
+            let mut bound = link(node, slots.node_object_bound_list);
+            while let Some(current) = object {
+                let Some(current_bound) = bound else {
+                    return Ok(None);
+                };
+                if sphere_hits_bound(
+                    &sphere_now(),
+                    &kd_bound_of(current_bound, &slots.object_bound),
+                ) {
+                    process(activation, current)?;
+                }
+                object = link(current, slots.object_next);
+                bound = link(current_bound, slots.object_next);
+            }
+            if let Some(positive) = positive
+                && sphere_hits_bound(&sphere_now(), &kd_bound_of(positive, &slots.node_bound))
+                && kd_walk(activation, call, slots, positive, depth + 1)?.is_none()
+            {
+                return Ok(None);
+            }
+            if sphere_hits_bound(&sphere_now(), &kd_bound_of(negative, &slots.node_bound))
+                && kd_walk(activation, call, slots, negative, depth + 1)?.is_none()
+            {
+                return Ok(None);
+            }
+        }
+    } else {
+        let mut object = link(node, slots.node_object_list);
+        while let Some(current) = object {
+            process(activation, current)?;
+            object = link(current, slots.object_next);
+        }
+    }
+    Ok(Some(()))
+}
+
+/// `KDContainer.d33b25fe` — обход KD-дерева при вставке динамики: спуск по знаку расстояния
+/// сферы до плоскости узла, проверка габаритов нативно, а свёртка матрицы и сбор плоскостей
+/// каждого задетого объекта — его собственными методами (первый — нативной заменой, второй —
+/// байткодом: он виртуальный и разный у Mesh, BSP и контейнеров).
+///
+/// Частичный порт без собственных записей: всё пишут вложенные вызовы. Поэтому в режиме сверки
+/// замена не запускается (`comparable`) — их записи не откатить, а составные части сверяются
+/// по отдельности.
+fn kd_collect_planes<'gc>(
+    activation: &mut Activation<'_, 'gc>,
+) -> Result<Option<Value<'gc>>, crate::avm2::Error<'gc>> {
+    let Some(this) = activation.local_register(0).as_object() else {
+        return Ok(None);
+    };
+    let Some(node) = activation.local_register(1).as_object() else {
+        return Ok(None);
+    };
+    let Some(sphere) = activation.local_register(2).as_object() else {
+        return Ok(None);
+    };
+    let Some(v3) = vector3d_slots(activation, sphere) else {
+        return Ok(None);
+    };
+
+    // Слоты узла разбираются по живому объекту из его списков; пустое дерево — интерпретатору
+    // (там и работы нет).
+    let sample_object = {
+        let mut probe = node;
+        let mut found = None;
+        for _ in 0..64 {
+            let list = slot_of(activation, probe, "objectList", false)
+                .or_else(|| slot_of(activation, probe, "objectList", true));
+            if let Some(list_slot) = list
+                && let Some(object) = probe.get_slot(list_slot).as_object()
+            {
+                found = Some(object);
+                break;
+            }
+            let down = slot_of(activation, probe, "negative", false)
+                .or_else(|| slot_of(activation, probe, "negative", true))
+                .and_then(|slot| probe.get_slot(slot).as_object());
+            match down {
+                Some(next) => probe = next,
+                None => break,
+            }
+        }
+        found
+    };
+    let Some(sample_object) = sample_object else {
+        return Ok(None);
+    };
+    let Some(slots) = kd_slots(activation, node, sample_object) else {
+        return Ok(None);
+    };
+    if node.vtable().id() != slots.node_vtable {
+        return Ok(None);
+    }
+
+    let mut passthrough = [Value::Undefined; 7];
+    for (at, value) in passthrough.iter_mut().enumerate() {
+        *value = activation.local_register(3 + at as u32);
+    }
+    let engine_ns = crate::avm2::namespace::Namespace::package(
+        AvmString::new_utf8(activation.gc(), ENGINE_NS),
+        crate::avm2::api_version::ApiVersion::VM_INTERNAL,
+        activation.strings(),
+    );
+    let call = KdCall {
+        this,
+        sphere,
+        sphere_slots: v3,
+        passthrough,
+        compose: Multiname::new(
+            engine_ns,
+            AvmString::new_utf8(activation.gc(), "composeAndAppend"),
+        ),
+        collect: Multiname::new(
+            engine_ns,
+            AvmString::new_utf8(activation.gc(), "collectPlanes"),
+        ),
+    };
+
+    match kd_walk(activation, &call, &slots, node, 0)? {
+        Some(()) => Ok(Some(Value::Undefined)),
+        // Обход упёрся в неожиданную структуру уже после чужих вызовов: доделать нечем, но и
+        // отдавать байткоду нельзя — он повторил бы вставки. Оставшееся дообходит байткод только
+        // если не было ни одного вызова; в живой сцене классы стабильны и сюда не попадают.
+        None => Ok(Some(Value::Undefined)),
+    }
+}
