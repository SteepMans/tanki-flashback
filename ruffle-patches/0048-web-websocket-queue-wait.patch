+    static SOCKET_QUEUE_WAIT: Cell<(f64, f64, u64)> = const { Cell::new((0.0, 0.0, 0)) };
     /// Моменты, когда ActionScript отдал порции на отправку, ещё не ушедшие в WebSocket.
     static SOCKET_OUT_STARTS: RefCell<VecDeque<Instant>> = const { RefCell::new(VecDeque::new()) };
     /// (сумма мс, максимум мс, порций) времени «flush() → отправлено в WebSocket» за период.
@@ -436,6 +440,19 @@ pub fn socket_wake_enabled() -> bool {
     SOCKET_WAKE.load(Ordering::Relaxed)
 }
 
+/// WS-событие простояло в очереди главного потока указанное время до начала обработчика.
+pub fn record_socket_queue_wait(ms: f64) {
+    SOCKET_QUEUE_WAIT.with(|wait| {
+        let (sum, max, count) = wait.get();
+        wait.set((sum + ms, max.max(ms), count + 1));
+    });
+}
+
+/// (сумма мс, максимум мс, событий) ожидания в очереди за период; счётчики обнуляются.
+pub fn take_socket_queue_wait() -> (f64, f64, u64) {
+    SOCKET_QUEUE_WAIT.with(|wait| wait.replace((0.0, 0.0, 0)))
+}
+
