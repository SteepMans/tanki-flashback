# Скопировать в server/.env и поправить под себя. Файл .env в репозиторий не попадает.

# Порты. PORT — игровой TCP-сокет, к нему подключается клиент (или wss-прокси).
# RESOURCE_PORT — HTTP-сервер ресурсов: config.xml, SWF клиента, игровые ресурсы, /web, /panel.
PORT=1337
RESOURCE_PORT=9999

# База. MySQL 8. Либо одна строка MYSQL_URL, либо поля по отдельности.
# Пример для контейнера из README: порт 33306, пользователь root.
MYSQL_HOST=localhost
MYSQL_PORT=33306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=letanki
# MYSQL_URL=mysql://user:password@host:3306/letanki

# DB_SYNC=0 отключает приведение схемы к сущностям при старте. По умолчанию включено:
# на боевом стенде схему разумнее двигать руками.
# DB_SYNC=0
# DB_LOG=1 печатает SQL.

# MongoDB нужна ТОЛЬКО для разового переноса данных со старой схемы
# (scripts/migrate-mongo-to-mysql.ts). Сервер её не читает.
# MONGODB_URI=mongodb://localhost:27017/letanki

# Логи.
ENABLE_CONSOLE_LOGGING=true
LOG_LEVEL=info

# Веб-панель, которую клиент открывает кнопкой в лобби (scripts/patches/webpanel-button.js).
# Адрес должен быть доступен клиенту, а не только серверу.
WEBPANEL_URL=http://localhost:9999/panel

# Публичный адрес стенда. Подставляется в ссылки подтверждения почты и сброса пароля,
# а также в профиль игрока. Для локальной работы можно не задавать — возьмётся localhost.
# SERVER_HOST=example.com
# PROFILE_URL_BASE=http://example.com/user/

# Почта. Нужна только для подтверждения адреса и сброса пароля; без неё эти сценарии
# выключаются, остальное работает. Для Gmail нужен App Password, а не пароль аккаунта.
# EMAIL_USER=
# EMAIL_PASSWORD=
# EMAIL_FROM=
# EMAIL_CONFIRMATION_URL_BASE=
# PASSWORD_RESET_URL_BASE=

# Зеркало, с которого scripts/downloadResource.ts и scripts/extractSkyboxes.ts тянут
# ресурсы по описателю. Адрес не входит в репозиторий — задать самому.
# RESOURCE_MIRROR=http://mirror.example.com

# Боты. BOT_BATTLES=0 выключает их полностью.
# BOT_BATTLES=1
# BOTS_PER_BATTLE=4

# Нагрузочные скрипты (npm run stress, npm run targets).
# STRESS_HOST=127.0.0.1
# STRESS_PORT=1337
# STRESS_PASSWORD=
# TARGETS_PASSWORD=
